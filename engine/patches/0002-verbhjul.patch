+// What the input script of Zak FM-Towns (global script 11) uses; read from
+// the decompiled scripts (see docs/VERBHJUL.md).
+enum {
+	kVarVerb = 116,         // verb of the sentence being built
+	kVarObjA = 117,         // first object
+	kVarObjB = 118,         // second object
+	kVarPrep = 119,         // preposition (129 in, 130 with, 131 on, 132 to), 0 = none
+	kVarInventory = 102,    // objects shown in inventory slots 101..110
+	kZakWalkTo = 3,
+	kZakGive = 11,
+	kZakSell = 16,
+	kZakSwitch = 36,       // Switch; the kids' names are 37 to 40
+	kZakSentence = 100,    // the sentence line; clicking it runs the sentence
+	kZakInvFirst = 101,
+	kZakInvLast = 110,
+	kZakInvUp = 115,       // inventory arrows: they only scroll (script 20)
+	kZakInvDown = 116
+};
+
+// The verb an icon of the dynamic wheel sends when its group has several
+static const int kPriority[] = { 2, 7, 8, 5, 10, 4, 9, 12, 14, 1, 6, 11, 15, 16, 17 };
+
+static const char *const kKidLabel[4] = { "Zak", "Ann", "Mel", "Les" };
+
+// Portraits: four boxes in the bottom right corner of the 320 x 240 screen,
+// under the inventory, where the panel draws nothing
+static const int kPortraitW = 22, kPortraitH = 18, kPortraitGap = 2;
+
+// The inventory as a grid of pictures (HD layer, wheel on), in game pixels:
+// five cells in two rows filling everything under the sentence line, where the
+// verb panel and the text inventory were (Tom 15 October 2026). A column to the
+// right has the arrows at the top and bottom and the portraits between them.
+static const int kInvTop = 153, kInvBottom = 239;
+static const int kInvLeft = 1, kInvCellsRight = 271, kInvRight = 319;
+static const int kInvArrowH = 19;
+
+// Clock positions 12, 1, 2 ... 11; the second verb takes the place when the
+// first is not in the panel (shop, teleport).
+static const int kClock[12][2] = {
+	{ 8, 15 },   // Pick up / Buy
+	{ 2, 0 },    // Open
+	{ 7, 0 },    // Close
+	{ 14, 0 },   // Use
+	{ 11, 16 },  // Give / Sell
