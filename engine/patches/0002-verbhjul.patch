+/*
+ * Generated by tools/verbhjul_dynamisk.py in the ZakMcKracken-HD repository;
+ * do not edit by hand. The icons of the dynamic verb wheel for Zak McKracken
+ * FM-Towns, per object. The format is described in verbhjul.h.
+ */
+
+#ifndef SCUMM_VERBHJUL_ZAK_H
+#define SCUMM_VERBHJUL_ZAK_H
+
