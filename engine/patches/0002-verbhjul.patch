+
+// Placeholder icons until the drawn icons exist: at most three letters, so
+// they fit in the icon on the 320 x 240 screen. The text under the wheel
+// shows the whole verb while the pointer is on an icon.
+static inline const char *verbLabel(int v) {
+	switch (v) {
+	case 1: return "Psh";
+	case 2: return "Opn";
+	case 4: return "Put";
+	case 5: return "On";
+	case 6: return "Pul";
