+
+// Drawing the wheel, the inventory grid and the portraits on the HD layer.
+
+#define FORBIDDEN_SYMBOL_EXCEPTION_getenv
+
+#include "common/algorithm.h"
+#include "common/base64.h"
+#include "common/memstream.h"
+#include "common/config-manager.h"
+#include "common/debug.h"
+#include "common/endian.h"
+#include "common/fs.h"
+#include "common/system.h"
+#include "common/textconsole.h"
+#include "common/tokenizer.h"
+#include "graphics/font.h"
+#include "graphics/fontman.h"
+#include "graphics/surface.h"
+#include "image/png.h"
+
+#include "scumm/gfx.h"
+#include "scumm/object.h"
+#include "scumm/scumm.h"
+#include "scumm/verbs.h"
+#include "scumm/verbhjul.h"
+#include "scumm/verbhjul_intern.h"
+#include "scumm/verbhjul_ikoner.h"
+
+namespace Scumm {
+
+static bool decodePng(Common::SeekableReadStream &st, int &w, int &h, Common::Array<byte> &px) {
+	Image::PNGDecoder dec;
+	if (!dec.loadStream(st) || !dec.getSurface())
+		return false;
+	const Graphics::Surface *src = dec.getSurface();
+	Graphics::Surface *conv = src->convertTo(Graphics::PixelFormat::createFormatRGBA32(),
+		dec.getPalette().size() ? dec.getPalette().data() : nullptr, dec.getPalette().size());
+	if (!conv)
+		return false;
+	w = conv->w;
+	h = conv->h;
+	px.resize(w * h * 4);
+	for (int y = 0; y < h; y++) {
+		for (int x = 0; x < w; x++) {
+			const uint32 c = *(const uint32 *)conv->getBasePtr(x, y);
+			byte a, r, g, b;
+			conv->format.colorToARGB(c, a, r, g, b);
+			byte *d = &px[(y * w + x) * 4];
+			d[0] = r; d[1] = g; d[2] = b; d[3] = a;
+		}
+	}
+	conv->free();
+	delete conv;
+	return true;
+}
+
+static bool decodeEmbeddedPng(const char *b64, uint32 size, int &w, int &h, Common::Array<byte> &px) {
+	Common::String enc(b64);
+	Common::MemoryReadStream *st = Common::b64DecodeStream(enc, size);
+	if (!st)
+		return false;
+	const bool ok = decodePng(*st, w, h, px);
+	delete st;
+	return ok;
+}
+
+// A PNG in the HD pack (DIGHD_MOD / dighd_mod), for graphics from the artists
+bool VerbWheel::loadModPng(const Common::String &rel, Img &img) const {
+	Common::String mod = ConfMan.get("dighd_mod");
+	if (const char *env = getenv("DIGHD_MOD"))
+		mod = env;
+	if (mod.empty())
+		return false;
+	Common::FSNode node(Common::Path(mod, '/').join(Common::Path(rel, '/')));
+	if (!node.exists())
+		return false;
+	Common::SeekableReadStream *st = node.createReadStream();
+	if (!st)
+		return false;
+	const bool ok = decodePng(*st, img.w, img.h, img.px);
+	delete st;
+	if (!ok)
+		warning("Verbhjul: could not read %s in the HD pack", rel.c_str());
+	return ok;
+}
+
+void VerbWheel::loadHD() {
+	if (_hdLoaded)
+		return;
+	_hdLoaded = true;
+	int n = 0, fromMod = 0;
+	for (const VerbWheelIcon *ic = kVerbWheelIcons; ic->png; ic++) {
+		Img img;
+		// Icons painted by the artists (ui/verbhjul/<name>.png in the HD pack)
+		// take the place of the built-in ones
+		if (loadModPng(Common::String::format("ui/verbhjul/%s.png", ic->name), img)) {
+			fromMod++;
+		} else if (!decodeEmbeddedPng(ic->png, ic->size, img.w, img.h, img.px)) {
+			warning("Verbhjul: could not read the icon %s", ic->name);
+			continue;
+		}
+		_iconSrc[ic->verb] = img;
+		n++;
+	}
+	if (!decodeEmbeddedPng(kVerbWheelFontPng, kVerbWheelFontPngSize, _font.w, _font.h, _font.px))
+		warning("Verbhjul: could not read the font");
+	debug("Verbhjul: %d drawn icons (%d from the HD pack), font %d x %d", n, fromMod, _font.w, _font.h);
+}
+
+// An image at a size that fits w x h (keeps its shape), area-averaged with premultiplied alpha
+void VerbWheel::scaleImg(const Img &src, int w, int h, Img &dst) {
+	const float k = MIN((float)w / src.w, (float)h / src.h);
+	dst.w = MAX(1, (int)(src.w * k + 0.5f));
+	dst.h = MAX(1, (int)(src.h * k + 0.5f));
+	dst.px.resize(dst.w * dst.h * 4);
+	const float fx = (float)src.w / dst.w, fy = (float)src.h / dst.h;
+	const int n = MAX(2, (int)ceilf(MAX(fx, fy)) + 1);
+	for (int y = 0; y < dst.h; y++) {
+		for (int x = 0; x < dst.w; x++) {
+			float r = 0, g = 0, b = 0, a = 0;
+			for (int j = 0; j < n; j++) {
+				const int sy = CLIP<int>((int)((y + (j + 0.5f) / n) * fy), 0, src.h - 1);
+				for (int i = 0; i < n; i++) {
+					const int sx = CLIP<int>((int)((x + (i + 0.5f) / n) * fx), 0, src.w - 1);
+					const byte *p = &src.px[(sy * src.w + sx) * 4];
+					const float al = p[3] / 255.0f;
+					r += p[0] * al; g += p[1] * al; b += p[2] * al; a += al;
+				}
+			}
+			byte *d = &dst.px[(y * dst.w + x) * 4];
+			if (a > 0) {
+				d[0] = (byte)CLIP<float>(r / a + 0.5f, 0, 255);
+				d[1] = (byte)CLIP<float>(g / a + 0.5f, 0, 255);
+				d[2] = (byte)CLIP<float>(b / a + 0.5f, 0, 255);
+			} else {
+				d[0] = d[1] = d[2] = 0;
+			}
+			d[3] = (byte)CLIP<float>(a / (n * n) * 255 + 0.5f, 0, 255);
+		}
+	}
+}
+
+const VerbWheel::Img *VerbWheel::iconAt(int verb, int size) {
+	const int key = verb * 1000 + size;
+	if (_iconCache.contains(key))
+		return &_iconCache[key];
+	if (!_iconSrc.contains(verb) || size <= 0)
+		return nullptr;
+	scaleImg(_iconSrc[verb], size, size, _iconCache[key]);
+	return &_iconCache[key];
+}
+
+// The picture of an inventory object, or nullptr. Many things change name with
+// their look (fish bowl, taped fish bowl, lit lighter), so a picture for the
+// current name wins: inventory/objNNN-<name>.png (lower case, other letters
+// than a-z and 0-9 as '-'), else inventory/objNNN.png.
+static Common::String nameSlug(const Common::String &name) {
+	Common::String out;
+	for (uint i = 0; i < name.size(); i++) {
+		const char c = name[i];
+		if (Common::isAlnum(c))
+			out += (char)tolower(c);
+		else if (!out.empty() && out.lastChar() != '-')
+			out += '-';
+	}
+	while (!out.empty() && out.lastChar() == '-')
+		out.deleteLastChar();
+	return out;
+}
+
+const VerbWheel::Img *VerbWheel::inventoryImage(int obj, int w, int h) {
+	const Common::String slug = nameSlug(objectName(obj));
+	const Common::String key = Common::String::format("%d:%s", obj, slug.c_str());
+	if (!_invSrc.contains(key)) {
+		Img img;
+		const Common::String named = Common::String::format("inventory/obj%03d-%s.png", obj, slug.c_str());
+		const Common::String plain = Common::String::format("inventory/obj%03d.png", obj);
+		if ((!slug.empty() && loadModPng(named, img)) || loadModPng(plain, img))
+			debug("Verbhjul: inventory picture for object %d \"%s\" (%d x %d)", obj, slug.c_str(), img.w, img.h);
+		_invSrc[key] = img;   // empty: none, and not looked for again
+	}
+	const Img &src = _invSrc[key];
+	if (!src.w)
+		return nullptr;
+	const Common::String ck = Common::String::format("%s:%dx%d", key.c_str(), w, h);
+	if (!_invCache.contains(ck))
+		scaleImg(src, w, h, _invCache[ck]);
+	return &_invCache[ck];
+}
+
+int VerbWheel::textWidth(const Common::String &text, float f) const {
+	float w = 0;
+	for (uint i = 0; i < text.size(); i++) {
+		const int c = (byte)text[i];
+		if (c >= 32 && c < 127)
+			w += kVerbWheelGlyphs[c - 32][6] * f;
+	}
+	return (int)ceilf(w);
+}
