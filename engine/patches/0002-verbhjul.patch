+namespace Scumm {
+
+void VerbWheel::parseTests(const char *spec) {
+	Common::StringTokenizer tok(spec, ",");
+	while (!tok.empty()) {
+		const Common::String item = tok.nextToken();
+		const size_t colon = item.find(':');
+		if (colon == Common::String::npos)
+			continue;
+		TestCmd t;
+		t.frame = atoi(item.substr(0, colon).c_str());
+		Common::String rest = item.substr(colon + 1);
+		const size_t eq = rest.find('=');
+		t.cmd = eq == Common::String::npos ? rest : rest.substr(0, eq);
+		t.arg = eq == Common::String::npos ? Common::String() : rest.substr(eq + 1);
+		_tests.push_back(t);
+	}
+	debug("Verbhjul: %d test commands", (int)_tests.size());
+}
+
+void VerbWheel::pushMouse(Common::EventType type, int x, int y) {
+	const int sw = g_system->getWidth(), sh = g_system->getHeight();
+	Common::Event ev;
+	ev.type = type;
+	ev.mouse = Common::Point(x * sw / _vm->_screenWidth + sw / _vm->_screenWidth / 2,
+	                         y * sh / _vm->_screenHeight + sh / _vm->_screenHeight / 2);
+	g_system->getEventManager()->pushEvent(ev);
+}
+
+void VerbWheel::pushKey(Common::KeyCode code, uint16 ascii, byte flags) {
+	Common::Event ev;
+	ev.type = Common::EVENT_KEYDOWN;
+	ev.kbd = Common::KeyState(code, ascii, flags);
+	g_system->getEventManager()->pushEvent(ev);
+	ev.type = Common::EVENT_KEYUP;
+	g_system->getEventManager()->pushEvent(ev);
+}
+
+static bool parseXY(const Common::String &s, int &x, int &y) {
+	const size_t slash = s.find('/');
+	if (slash == Common::String::npos)
+		return false;
+	x = atoi(s.substr(0, slash).c_str());
+	y = atoi(s.substr(slash + 1).c_str());
+	return true;
+}
+
+void VerbWheel::runTests() {
+	if (_upFrame == (int)_frame) {
+		Common::Point p = _upPos;
+		if (_rdragVerb) {
+			for (int i = 0; i < 12; i++)
+				if (_slots[i] == _rdragVerb && _state == kOpen)
+					p = slotCenter(i);
+			pushMouse(Common::EVENT_MOUSEMOVE, p.x, p.y);
+			_rdragVerb = 0;
+		}
+		pushMouse(_upRight ? Common::EVENT_RBUTTONUP : Common::EVENT_LBUTTONUP, p.x, p.y);
+		_upFrame = -1;
+	}
+	for (uint i = 0; i < _tests.size(); i++) {
+		const TestCmd &t = _tests[i];
+		if (t.frame != (int)_frame)
+			continue;
+		int x = 0, y = 0;
+		debug("Verbhjul: test %s %s at frame %u (room %d)", t.cmd.c_str(), t.arg.c_str(), _frame, _vm->_currentRoom);
+		if (t.cmd == "esc") {
+			pushKey(Common::KEYCODE_ESCAPE, Common::ASCII_ESCAPE);
+		} else if (t.cmd == "key" && !t.arg.empty()) {
+			pushKey((Common::KeyCode)t.arg[0], t.arg[0]);
+		} else if (t.cmd == "ctrl" && !t.arg.empty()) {
+			pushKey((Common::KeyCode)t.arg[0], t.arg[0], Common::KBD_CTRL);
+		} else if (t.cmd == "fkey") {
+			const int n = atoi(t.arg.c_str());
+			if (n >= 1 && n <= 12)
+				pushKey((Common::KeyCode)(Common::KEYCODE_F1 + n - 1), Common::ASCII_F1 + n - 1);
+		} else if (t.cmd == "portrait") {
+			const int k = atoi(t.arg.c_str());
+			if (k >= 1 && k <= 4) {
+				const Common::Rect r = portraitRect(k);
+				const Common::Point p((r.left + r.right) / 2, (r.top + r.bottom) / 2);
+				pushMouse(Common::EVENT_MOUSEMOVE, p.x, p.y);
+				pushMouse(Common::EVENT_LBUTTONDOWN, p.x, p.y);
+				_upFrame = _frame + 2;
+				_upRight = false;
+				_upPos = p;
+			}
+		} else if (t.cmd == "setvar" && parseXY(t.arg, x, y)) {
+			// setvar=n/value
+			if (x >= 0 && x < _vm->_numVariables)
+				_vm->_scummVars[x] = y;
+		} else if (t.cmd == "setbit") {
+			// setbit=n.bit/value
+			const size_t dot = t.arg.find('.'), slash = t.arg.find('/');
+			if (dot != Common::String::npos && slash != Common::String::npos) {
+				const int n = atoi(t.arg.c_str()), bit = atoi(t.arg.c_str() + dot + 1);
+				if (n >= 0 && n < _vm->_numVariables && bit >= 0 && bit < 32) {
+					if (atoi(t.arg.c_str() + slash + 1))
+						_vm->_scummVars[n] |= (1u << bit);
+					else
+						_vm->_scummVars[n] &= ~(1u << bit);
+				}
+			}
+		} else if (t.cmd == "script") {
+			_vm->runScript(atoi(t.arg.c_str()), false, false, nullptr);
+		} else if (t.cmd == "rules") {
+			int n = 0, bad = 0;
+			for (const VerbWheelRule *r = kZakVerbWheelRules; r->spec; r++, n++) {
+				Common::Array<Common::String> words;
+				Common::StringTokenizer tok(r->spec, " ");
+				while (!tok.empty())
+					words.push_back(tok.nextToken());
+				Common::sort(words.begin(), words.end());
+				Common::String want;
+				for (uint k = 0; k < words.size(); k++)
+					want += (k ? " " : "") + words[k];
+				const Common::String got = _rules.contains(r->obj) ? ruleText(_rules[r->obj]) : Common::String();
+				if (got != want) {
+					bad++;
+					debug("Verbhjul: rule %d differs: \"%s\" read as \"%s\"", r->obj, r->spec, got.c_str());
+				}
+			}
+			debug("Verbhjul: rules checked: %d, %d differ", n, bad);
+		} else if ((t.cmd == "click" || t.cmd == "rclick") && parseXY(t.arg, x, y)) {
+			const bool right = t.cmd == "rclick";
+			pushMouse(Common::EVENT_MOUSEMOVE, x, y);
+			pushMouse(right ? Common::EVENT_RBUTTONDOWN : Common::EVENT_LBUTTONDOWN, x, y);
+			_upFrame = _frame + 3;
+			_upRight = right;
+			_upPos = Common::Point(x, y);
+		} else if (t.cmd == "rdrag") {
+			const size_t gt = t.arg.find('>');
+			if (gt != Common::String::npos && parseXY(t.arg.substr(0, gt), x, y)) {
+				pushMouse(Common::EVENT_MOUSEMOVE, x, y);
+				pushMouse(Common::EVENT_RBUTTONDOWN, x, y);
+				_rdragVerb = atoi(t.arg.substr(gt + 1).c_str());
+				_upFrame = _frame + 3;
+				_upRight = true;
+				_upPos = Common::Point(x, y);
+			}
+		} else if (t.cmd == "pick") {
+			const int v = atoi(t.arg.c_str());
+			bool found = false;
+			for (int k = 0; k < 12 && !found; k++) {
+				if (_slots[k] == v && _state == kOpen) {
+					const Common::Point p = slotCenter(k);
+					pushMouse(Common::EVENT_MOUSEMOVE, p.x, p.y);
+					pushMouse(Common::EVENT_LBUTTONDOWN, p.x, p.y);
+					_upFrame = _frame + 2;
+					_upRight = false;
+					_upPos = p;
+					found = true;
+				}
+			}
+			if (!found)
+				debug("Verbhjul: test pick: verb %d is not in the wheel", v);
+		} else if (t.cmd == "give") {
+			// give=OBJ: an object in this room into the inventory, as pickupObject
+			// does (test of a full inventory)
+			const int obj = atoi(t.arg.c_str());
+			if (_vm->whereIsObject(obj) == WIO_ROOM) {
+				_vm->addObjectToInventory(obj, _vm->_roomResource);
+				_vm->putOwner(obj, _vm->_scummVars[_vm->VAR_EGO]);
+				_vm->putClass(obj, kObjectClassUntouchable, 1);
+				_vm->putState(obj, 1);
+				_vm->runInventoryScript(1);
+			}
+		} else if (t.cmd == "wheel") {
+			// wheel=up@x/y or wheel=down@x/y
+			const size_t sl = t.arg.find('@');
+			if (sl != Common::String::npos && parseXY(t.arg.substr(sl + 1), x, y))
+				pushMouse(t.arg.hasPrefix("up") ? Common::EVENT_WHEELUP : Common::EVENT_WHEELDOWN, x, y);
+		} else if (t.cmd == "move" && parseXY(t.arg, x, y)) {
+			pushMouse(Common::EVENT_MOUSEMOVE, x, y);
+		} else if (t.cmd == "hover") {
+			// hover=V: the pointer onto the icon of verb V, without a click
+			const int v = atoi(t.arg.c_str());
+			for (int k = 0; k < 12; k++) {
+				if (_slots[k] == v && _state == kOpen) {
+					const Common::Point p = slotCenter(k);
+					pushMouse(Common::EVENT_MOUSEMOVE, p.x, p.y);
+					break;
+				}
+			}
+		} else if (t.cmd == "dump") {
+			dumpScreen(t.arg.empty() ? Common::String::format("verbhjul_%05u", _frame) : t.arg);
+		} else if (t.cmd == "log") {
+			Common::String sl;
+			for (int k = 0; k < 12; k++)
+				sl += Common::String::format(" %d", _slots[k]);
+			debug("Verbhjul: state %d, room %d, userPut %d, cursor %d, ego %d, verb %d, obj %d, obj2 %d, prep %d, slots%s",
+			      (int)_state, _vm->_currentRoom, _vm->_userPut, _vm->_cursor.state, _vm->_scummVars[_vm->VAR_EGO],
+			      _vm->_scummVars[kVarVerb], _vm->_scummVars[kVarObjA], _vm->_scummVars[kVarObjB],
+			      _vm->_scummVars[kVarPrep], sl.c_str());
+		} else if (t.cmd == "quit") {
+			_vm->quitGame();
+		}
+	}
+}
+
+void VerbWheel::dumpScreen(const Common::String &name) {
+	if (_dumpDir.empty())
+		return;
+	Graphics::Surface *s = g_system->lockScreen();
+	if (!s)
+		return;
+	Common::FSNode node(Common::FSNode(Common::Path(_dumpDir, Common::Path::kNativeSeparator)).getChild(name + ".png"));
+	Common::WriteStream *ws = node.createWriteStream();
+	if (ws) {
+		if (s->format.bytesPerPixel == 1)
+			::Image::writePNG(*ws, *s, _vm->_currentPalette);
+		else
+			::Image::writePNG(*ws, *s);
+		ws->finalize();
+		delete ws;
+	}
+	g_system->unlockScreen();
+	debug("Verbhjul: dumped %s.png", name.c_str());
+}
+
+} // End of namespace Scumm
