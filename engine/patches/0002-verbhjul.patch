+void VerbWheel::setEnabled(bool on) {
+	if (_state != kClosed)
+		close();
+	_enabled = on;
+	ConfMan.setBool("verbhjul", on, Common::ConfigManager::kApplicationDomain);
+	ConfMan.flushToDisk();
+	_vm->redrawVerbs();
+	debug("Verbhjul: switched %s", on ? "on" : "off");
+}
+
+bool VerbWheel::hidesVerb(int verbid) const {
+	return (_enabled && verbid >= 1 && verbid <= 17) || (_portraits && verbid == kZakSwitch) ||
+	       (_invGridOn && ((verbid >= kZakInvFirst && verbid <= kZakInvLast) || verbid == kZakInvUp || verbid == kZakInvDown));
+}
+
+bool VerbWheel::verbActive(int verbid) const {
+	const int slot = _vm->getVerbSlot(verbid, 0);
+	return slot > 0 && _vm->_verbs[slot].curmode == 1;
+}
+
+// ------------------------------------------------------------------ targets
+
+bool VerbWheel::targetAt(int x, int y, int &obj, int &invVerb, Common::Point &virt) {
+	obj = 0;
+	invVerb = 0;
+	const int slot = _vm->findVerbAtPos(x, y);
+	if (slot > 0) {
+		const int id = _vm->_verbs[slot].verbid;
+		if (id >= kZakInvFirst && id <= kZakInvLast) {
+			obj = _vm->_scummVars[kVarInventory + id - kZakInvFirst];
+			invVerb = id;
+			return obj > 0 && _vm->whereIsObject(obj) != WIO_NOT_FOUND;
+		}
+		return false;
+	}
+	VirtScreen *vs = _vm->findVirtScreen(y);
+	if (!vs || vs->number != kMainVirtScreen)
+		return false;
+	virt.x = x + vs->xstart;
+	virt.y = y - vs->topline;
+	obj = _vm->findObject(virt.x, virt.y);
+	return obj > 0;
+}
+
+void VerbWheel::collectVerbs(int obj, bool inventory) {
+	if (_dynamic && !_allVerbs && _rules.contains(obj)) {
+		collectDynamic(_rules[obj], obj, inventory);
+		return;
+	}
+	Common::Array<int> own;
+	const byte *ob = _vm->getOBCDFromObject(obj);
+	if (ob) {
+		// GF_SMALL_HEADER: the verb table starts 19 bytes into the OC block
+		// (as in ScummEngine::getVerbEntrypoint); entries are verb, offset
+		const uint32 size = READ_LE_UINT32(ob);
+		for (const byte *p = ob + 19; p + 3 <= ob + size && *p; p += 3)
+			if (*p != 0xFF)
+				own.push_back(*p);
+	}
+	for (int i = 0; i < 12; i++) {
+		_slots[i] = 0;
+		for (int c = 0; c < 2; c++) {
+			const int v = kClock[i][c];
+			if (!v || !verbActive(v))
+				continue;
+			bool ok = _allVerbs;
+			for (uint k = 0; !ok && k < own.size(); k++)
+				ok = (own[k] == v);
+			// The sentence script handles Give and Sell for any item
+			if (inventory && (v == 11 || v == 16))
+				ok = true;
+			if (ok) {
+				_slots[i] = v;
+				break;
+			}
+		}
+	}
+}
+
+Common::String VerbWheel::ruleText(const Rule &rule) {
+	Common::String g = "g=";
+	for (uint i = 0; i < rule.groups.size(); i++) {
+		if (i)
+			g += ';';
+		for (uint k = 0; k < rule.groups[i].size(); k++)
+			g += Common::String::format(k ? ",%d" : "%d", rule.groups[i][k]);
+	}
+	Common::Array<Common::String> words;
+	words.push_back(g);
+	for (uint i = 0; i < rule.pairs.size(); i++) {
+		const Pair &p = rule.pairs[i];
+		Common::String w = Common::String::format("p=%d/%d:", p.a, p.b);
+		for (uint c = 0; c < p.conds.size(); c++) {
+			const Cond &cd = p.conds[c];
+			if (c)
+				w += '+';
+			w += cd.type;
+			if (cd.type == 'b')
+				w += Common::String::format("%d.%d", cd.arg, cd.bit);
+			else if (cd.arg)
+				w += Common::String::format("%d", cd.arg);
+			for (uint v = 0; v < cd.values.size(); v++)
+				w += Common::String::format(v ? "|%d" : "=%d", cd.values[v]);
+		}
+		words.push_back(w);
+	}
+	const uint32 masks[3] = { rule.invOnly, rule.roomOnly, rule.never };
+	const char names[3] = { 'i', 'r', 'x' };
+	for (int m = 0; m < 3; m++) {
+		if (!masks[m])
+			continue;
+		Common::String w = Common::String::format("%c=", names[m]);
+		bool first = true;
+		for (int v = 1; v < 32; v++) {
+			if (masks[m] & (1u << v)) {
+				w += Common::String::format(first ? "%d" : ",%d", v);
+				first = false;
+			}
+		}
+		words.push_back(w);
+	}
+	Common::sort(words.begin(), words.end());
+	Common::String out;
+	for (uint i = 0; i < words.size(); i++)
+		out += (i ? " " : "") + words[i];
+	return out;
+}
+
+bool VerbWheel::condition(const Cond &c, int obj) const {
+	// Checked here, not when the rules are read: the game's sizes are not known yet then.
+	// Out of range would stop the game (assertRange) or read outside the variables.
+	const bool ok = (c.type == 's' && c.arg >= 0 && (c.arg ? c.arg : obj) < _vm->_numGlobalObjects) ||
+		((c.type == 'c' || c.type == 'C') && c.arg >= 1 && c.arg <= 32 && obj < _vm->_numGlobalObjects) ||
+		((c.type == 'v' || c.type == 'b') && c.arg >= 0 && c.arg < _vm->_numVariables && c.bit >= 0 && c.bit < 32);
+	if (!ok) {
+		warning("Verbhjul: condition %c%d for object %d is out of range", c.type, c.arg, obj);
+		return false;
+	}
+	switch (c.type) {
+	case 's':
+		return _vm->getState(c.arg ? c.arg : obj) != 0;
+	case 'c':
+		return _vm->getClass(obj, c.arg);
+	case 'C':
+		return !_vm->getClass(obj, c.arg);
+	case 'v': {
+		const int value = _vm->_scummVars[c.arg];
+		for (uint i = 0; i < c.values.size(); i++)
+			if (c.values[i] == value)
+				return true;
+		return false;
+	}
+	case 'b':
+		return ((uint32)_vm->_scummVars[c.arg] >> c.bit) & 1;
+	default:
+		return false;
+	}
+}
+
+void VerbWheel::placeVerb(int v) {
+	int slot = -1;
+	for (int i = 0; i < 12 && slot < 0; i++)
+		if (kClock[i][0] == v || kClock[i][1] == v)
+			slot = i;
+	if (slot < 0)
+		return;
+	// Two icons for the same place (not expected): the next free place clockwise
+	for (int n = 0; n < 12; n++) {
+		const int i = (slot + n) % 12;
+		if (!_slots[i]) {
+			_slots[i] = v;
+			return;
+		}
+	}
+}
+
+void VerbWheel::collectDynamic(const Rule &rule, int obj, bool inventory) {
+	for (int i = 0; i < 12; i++)
+		_slots[i] = 0;
+	// The groups, without the verbs that are not shown here or not in the panel now
+	Common::Array<Common::Array<int> > groups;
+	Common::Array<int> shown;
+	for (uint g = 0; g < rule.groups.size(); g++) {
+		Common::Array<int> verbs;
+		for (uint k = 0; k < rule.groups[g].size(); k++) {
+			const int v = rule.groups[g][k];
+			const uint32 bit = (v > 0 && v < 32) ? 1u << v : 0;
+			if ((rule.never & bit) || (!inventory && (rule.invOnly & bit)) || (inventory && (rule.roomOnly & bit)))
+				continue;
+			if (!verbActive(v))
+				continue;
+			verbs.push_back(v);
+		}
+		if (!verbs.empty()) {
+			groups.push_back(verbs);
+			shown.push_back(0);
+		}
+	}
+	// Pairs: only one of the two icons, by the state of the object
+	for (uint p = 0; p < rule.pairs.size(); p++) {
+		const Pair &pr = rule.pairs[p];
+		int ia = -1, ib = -1;
+		for (uint g = 0; g < groups.size(); g++) {
+			for (uint k = 0; k < groups[g].size(); k++) {
+				if (groups[g][k] == pr.a && ia < 0)
+					ia = g;
+				if (groups[g][k] == pr.b && ib < 0)
+					ib = g;
+			}
+		}
+		if (ia < 0 || ib < 0 || ia == ib)
+			continue;
+		bool showB = false;
+		for (uint c = 0; c < pr.conds.size() && !showB; c++)
+			showB = condition(pr.conds[c], obj);
+		if (showB) {
+			shown[ib] = pr.b;
+			groups[ia].clear();
+		} else {
+			shown[ia] = pr.a;
+			groups[ib].clear();
+		}
+	}
+	bool give = false;
+	for (uint g = 0; g < groups.size(); g++) {
+		if (groups[g].empty())
+			continue;
+		int v = shown[g];
+		for (uint n = 0; !v && n < ARRAYSIZE(kPriority); n++)
+			for (uint k = 0; k < groups[g].size(); k++)
+				if (groups[g][k] == kPriority[n])
+					v = kPriority[n];
+		if (!v)
+			v = groups[g][0];
+		if (v == kZakGive || v == kZakSell)
+			give = true;
+		placeVerb(v);
+	}
+	// The sentence script handles Give (Sell in the shop) for any item
+	if (inventory && !give) {
+		if (verbActive(kZakGive) && !(rule.never & (1u << kZakGive)))
+			placeVerb(kZakGive);
+		else if (verbActive(kZakSell) && !(rule.never & (1u << kZakSell)))
+			placeVerb(kZakSell);
+	}
+}
+
+// ------------------------------------------------------------------ portraits
+
+bool VerbWheel::kidAvailable(int kid) const {
+	// As ScummVM's F1 to F4 (checkExecVerbs): Zak Var[144] bit 15, Annie, Melissa
+	// and Leslie Var[145] bits 0 to 2; a set bit means the kid can not be chosen
+	return !_vm->readVar(0x890E + kid);
+}
+
+bool VerbWheel::portraitsShown() const {
+	if (!_portraits || _vm->_mainMenuIsActive)
+		return false;
+	const int slot = _vm->getVerbSlot(kZakSwitch, 0);
+	if (slot <= 0 || _vm->_verbs[slot].curmode != 1)
+		return false;
+	for (int k = 1; k <= 4; k++)
+		if (k != _vm->_scummVars[_vm->VAR_EGO] && kidAvailable(k))
+			return true;
+	return false;
+}
+
+Common::Rect VerbWheel::portraitRect(int kid) const {
+	if (_invGridOn) {
+		// Two by two in the column right of the inventory grid, between the arrows
+		const int x = kInvCellsRight + 3 + ((kid - 1) % 2) * (kPortraitW + kPortraitGap);
+		const int y = kInvTop + kInvArrowH + 2 + ((kid - 1) / 2) * (kPortraitW + 1);
+		return Common::Rect(x, y, x + kPortraitW, y + kPortraitW);
+	}
+	const int total = 4 * kPortraitW + 3 * kPortraitGap;
+	const int x = _vm->_screenWidth - 2 - total + (kid - 1) * (kPortraitW + kPortraitGap);
+	const int y = _vm->_screenHeight - 2 - kPortraitH;
+	return Common::Rect(x, y, x + kPortraitW, y + kPortraitH);
+}
+
+int VerbWheel::portraitAt(int x, int y) const {
+	if (!portraitsShown())
+		return 0;
+	for (int k = 1; k <= 4; k++)
+		if (kidAvailable(k) && portraitRect(k).contains(x, y))
+			return k;
+	return 0;
+}
+
+void VerbWheel::drawPortraits() {
+	// With the inventory grid the portraits are drawn in HD with it (drawInventory)
+	if (_invGridOn && _hdLoaded) {
+		if (!_portraitDrawn.isEmpty()) {
+			restoreScreenRect(_portraitDrawn);
+			_portraitDrawn = Common::Rect();
+		}
+		Common::String what;
+		if (portraitsShown()) {
+			what = Common::String::format("ego %d:", _vm->_scummVars[_vm->VAR_EGO]);
+			for (int k = 1; k <= 4; k++)
+				what += kidAvailable(k) ? '1' : '0';
+		}
+		if (what != _hdPortraitShown) {
+			debug("Verbhjul: portraits %s (HD, by the inventory)", what.empty() ? "hidden" : what.c_str());
+			_hdPortraitShown = what;
+		}
+		return;
+	}
+	Common::String what;
+	if (portraitsShown()) {
+		what = Common::String::format("ego %d:", _vm->_scummVars[_vm->VAR_EGO]);
+		for (int k = 1; k <= 4; k++)
+			what += kidAvailable(k) ? '1' : '0';
+	}
+	if (what.empty()) {
+		if (!_portraitDrawn.isEmpty()) {
+			restoreScreenRect(_portraitDrawn);
+			_portraitDrawn = Common::Rect();
+			_portraitShown.clear();
+			debug("Verbhjul: portraits hidden");
+		}
+		return;
+	}
+	if (what != _portraitShown) {
+		debug("Verbhjul: portraits %s", what.c_str());
+		if (!_portraitDrawn.isEmpty())
+			restoreScreenRect(_portraitDrawn);
+		_portraitShown = what;
+	}
+	Graphics::Surface *s = g_system->lockScreen();
+	if (!s)
+		return;
+	const Graphics::Font *font = FontMan.getFontByUsage(s->w >= 2 * _vm->_screenWidth ?
+		Graphics::FontManager::kGUIFont : Graphics::FontManager::kConsoleFont);
+	if (!font)
+		font = FontMan.getFontByUsage(Graphics::FontManager::kConsoleFont);
+	const uint32 cRing = color(*s, 214, 214, 224);
+	const uint32 cFill = color(*s, 32, 40, 72);
+	const uint32 cEgo = color(*s, 240, 196, 48);
+	const uint32 cText = color(*s, 255, 255, 255);
+	const uint32 cTextEgo = color(*s, 16, 16, 24);
+	const int ego = _vm->_scummVars[_vm->VAR_EGO];
+	Common::Rect all;
+	for (int k = 1; k <= 4; k++) {
+		if (!kidAvailable(k) && k != ego)
+			continue;
+		const Common::Rect r = toScreen(portraitRect(k));
+		Common::Rect rc = r;
+		rc.clip(Common::Rect(s->w, s->h));
+		if (rc.isEmpty())
+			continue;
+		s->fillRect(rc, k == ego ? cEgo : cFill);
+		s->frameRect(rc, cRing);
+		if (font)
+			font->drawString(s, kKidLabel[k - 1], rc.left, rc.top + (rc.height() - font->getFontHeight()) / 2,
+			                 rc.width(), k == ego ? cTextEgo : cText, Graphics::kTextAlignCenter);
+		if (all.isEmpty())
+			all = rc;
+		else
+			all.extend(rc);
+	}
+	g_system->unlockScreen();
+	_portraitDrawn = all;
+}
+
+// ------------------------------------------------------------------ wheel
+
+Common::Point VerbWheel::slotCenter(int i) const {
+	static const int kCos[12] = { 0, 500, 866, 1000, 866, 500, 0, -500, -866, -1000, -866, -500 };
+	static const int kSin[12] = { -1000, -866, -500, 0, 500, 866, 1000, 866, 500, 0, -500, -866 };
+	return Common::Point(_center.x + kRadius * kCos[i] / 1000, _center.y + kRadius * kSin[i] / 1000);
+}
+
+int VerbWheel::hoverAt(int x, int y) const {
+	for (int i = 0; i < 12; i++) {
+		if (!_slots[i])
+			continue;
+		const Common::Point c = slotCenter(i);
+		const int dx = x - c.x, dy = y - c.y;
+		if (dx * dx + dy * dy <= (kIcon + 2) * (kIcon + 2))
+			return i;
+	}
+	return -1;
+}
+
+bool VerbWheel::open(int x, int y, bool byPress) {
+	int obj, inv;
+	Common::Point virt;
+	if (!targetAt(x, y, obj, inv, virt))
+		return false;
+	collectVerbs(obj, inv != 0);
+	Common::String list;
+	for (int i = 0; i < 12; i++)
+		if (_slots[i])
+			list += Common::String::format(" %d", _slots[i]);
+	if (list.empty()) {
+		debug("Verbhjul: object %d has no verbs for the wheel; normal click", obj);
+		return false;
+	}
+	_obj = obj;
+	_invVerb = inv;
+	_virt = virt;
+	_state = kOpen;
+	_openedAt = g_system->getMillis();
+	_openedByPress = byPress;
+	_pressMoved = false;
+	_press = Common::Point(x, y);
+	_hover = -1;
+	// Room for the drawn icons (a little larger than the hit circles) at the edges
+	const int m = kRadius + 16;
+	_center.x = CLIP<int>(x, m, _vm->_screenWidth - 1 - m);
+	_center.y = CLIP<int>(y, m, _vm->_screenHeight - 1 - m - 12);
+	debug("Verbhjul: open on object %d \"%s\"%s at %d,%d, verbs%s", obj, objectName(obj).c_str(),
+	      inv ? Common::String::format(" (inventory slot %d)", inv).c_str() : "", x, y, list.c_str());
+	return true;
+}
+
+void VerbWheel::close() {
+	if (_state == kOpen)
+		debug("Verbhjul: closed");
+	_state = kClosed;
+	_hover = -1;
+	_openedByPress = false;
+}
+
+void VerbWheel::choose(int i) {
+	const int v = _slots[i];
+	debug("Verbhjul: chose %d (%s) for object %d", v, verbName(v).c_str(), _obj);
+	// Clicking the verb that is already selected would run the pending sentence
+	if (_vm->_scummVars[kVarVerb] == v)
+		queueStep(kStepVerb, kZakWalkTo, 0);
+	queueStep(kStepVerb, v, 0);
+	if (_invVerb)
+		queueStep(kStepVerb, _invVerb, 0);
+	else
+		queueStep(kStepScene, _virt.x, _virt.y);
+	// Runs the sentence, or waits for a second object (see tick)
+	queueStep(kStepCheck, v, _obj);
+	_waitVerb = v;
+	_waitObj = _obj;
+	close();
+}
+
+void VerbWheel::queueStep(StepType type, int a, int b) {
+	_stepRoom = _vm->_currentRoom;
+	_steps.push_back({ type, a, b });
+}
+
+void VerbWheel::queueTarget(int obj, int invVerb, const Common::Point &virt) {
+	debug("Verbhjul: second object %d%s", obj, invVerb ? Common::String::format(" (inventory slot %d)", invVerb).c_str() : "");
+	if (invVerb)
+		queueStep(kStepVerb, invVerb, 0);
+	else
+		queueStep(kStepScene, virt.x, virt.y);
+	queueStep(kStepCheck, _waitVerb, _waitObj);
+	_state = kClosed;
+}
+
+// ------------------------------------------------------------------ input
+
+bool VerbWheel::handleEvent(const Common::Event &ev) {
+	// The mouse wheel over the inventory scrolls it, as the arrows do
+	if ((ev.type == Common::EVENT_WHEELUP || ev.type == Common::EVENT_WHEELDOWN) && _invGridOn && _state != kOpen) {
+		const int sw = MAX<int>(1, g_system->getWidth()), sh = MAX<int>(1, g_system->getHeight());
+		const int y = ev.mouse.y * _vm->_screenHeight / sh, x = ev.mouse.x * _vm->_screenWidth / sw;
+		if (y >= kInvTop && y < kInvBottom && x >= kInvLeft && x < kInvRight) {
+			const int verb = ev.type == Common::EVENT_WHEELUP ? kZakInvUp : kZakInvDown;
+			const int slot = _vm->getVerbSlot(verb, 0);
+			if (slot > 0 && _vm->_verbs[slot].curmode == 1 && _vm->_userPut > 0 && !_vm->_mainMenuIsActive && _steps.size() < 2) {
+				debug("Verbhjul: mouse wheel %s in the inventory", verb == kZakInvUp ? "up" : "down");
+				queueStep(kStepVerb, verb, 0);
+			}
+			return true;
+		}
+	}
+	if (ev.type == Common::EVENT_KEYDOWN) {
+		if (ev.kbd.keycode == Common::KEYCODE_w && (ev.kbd.flags & Common::KBD_CTRL) &&
+		    !(ev.kbd.flags & (Common::KBD_ALT | Common::KBD_SHIFT))) {
+			setEnabled(!_enabled);
+			return true;
+		}
+		if (_state == kOpen && ev.kbd.keycode == Common::KEYCODE_ESCAPE) {
+			close();
+			return true;
+		}
+		return false;
+	}
+
+	const bool mouse = ev.type == Common::EVENT_MOUSEMOVE || ev.type == Common::EVENT_LBUTTONDOWN ||
+		ev.type == Common::EVENT_LBUTTONUP || ev.type == Common::EVENT_RBUTTONDOWN || ev.type == Common::EVENT_RBUTTONUP;
+	if (!mouse)
+		return false;
+	const int sw = MAX<int>(1, g_system->getWidth()), sh = MAX<int>(1, g_system->getHeight());
+	const int x = CLIP<int>(ev.mouse.x * _vm->_screenWidth / sw, 0, _vm->_screenWidth - 1);
+	const int y = CLIP<int>(ev.mouse.y * _vm->_screenHeight / sh, 0, _vm->_screenHeight - 1);
+	const bool canAct = _vm->_userPut > 0 && _vm->_cursor.state > 0 && !_vm->_mainMenuIsActive;
+	const bool canSwitch = _vm->_userPut > 0 && !_vm->_mainMenuIsActive;   // as the Switch button
+
+	// The portraits work with the wheel on or off
+	if (ev.type == Common::EVENT_LBUTTONDOWN && _state != kOpen) {
+		const int kid = portraitAt(x, y);
+		if (kid) {
+			if (canSwitch && kid != _vm->_scummVars[_vm->VAR_EGO]) {
+				debug("Verbhjul: portrait %d", kid);
+				_state = kClosed;
+				queueStep(kStepKid, kid, 0);
+			}
+			_swallowLeftUp = true;
+			return true;
+		}
+	}
+	if (!_enabled) {
+		if (ev.type == Common::EVENT_LBUTTONUP && _swallowLeftUp) {
+			_swallowLeftUp = false;
+			return true;
+		}
+		return false;
+	}
+
+	switch (ev.type) {
+	case Common::EVENT_MOUSEMOVE:
+		if (_state == kOpen) {
+			_hover = hoverAt(x, y);
+			if (ABS(x - _press.x) + ABS(y - _press.y) > 3)
+				_pressMoved = true;
+		}
+		return false;
+
+	case Common::EVENT_RBUTTONDOWN:
+		if (_state == kOpen) {
+			close();
+			_swallowRightUp = true;
+			return true;
+		}
+		if (_state == kWaitTarget) {
+			debug("Verbhjul: cancelled the sentence");
+			queueStep(kStepVerb, kZakWalkTo, 0);
+			_state = kClosed;
+			_swallowRightUp = true;
+			return true;
+		}
+		if (canAct && open(x, y, true)) {
+			_swallowRightUp = true;
+			return true;
+		}
+		return false;
+
+	case Common::EVENT_RBUTTONUP:
+		if (_state == kOpen && _openedByPress) {
+			_openedByPress = false;
+			const int h = hoverAt(x, y);
+			if (h >= 0 && _pressMoved)
+				choose(h);
+		}
+		if (_swallowRightUp) {
+			_swallowRightUp = false;
+			return true;
+		}
+		return false;
+
+	case Common::EVENT_LBUTTONDOWN:
+		if (_state == kOpen) {
+			const int h = hoverAt(x, y);
+			if (h >= 0)
+				choose(h);
+			else
+				close();
+			_swallowLeftUp = true;
+			return true;
+		}
+		if (_state == kWaitTarget) {
+			int obj, inv;
+			Common::Point virt;
+			const bool target = targetAt(x, y, obj, inv, virt);
+			VirtScreen *vs = _vm->findVirtScreen(y);
+			if (target || (vs && vs->number == kMainVirtScreen)) {
+				if (!target) {
+					virt.x = x + vs->xstart;
+					virt.y = y - vs->topline;
+				}
+				queueTarget(obj, inv, virt);
+				_swallowLeftUp = true;
+				return true;
+			}
+			// The inventory arrows only scroll, and the sentence keeps waiting
+			// (the input script chains to script 20 without touching it)
+			const int slot = _vm->findVerbAtPos(x, y);
+			if (slot > 0 && (_vm->_verbs[slot].verbid == kZakInvUp || _vm->_verbs[slot].verbid == kZakInvDown))
+				return false;
+			// Another button of the panel: the game handles it
+			_state = kClosed;
+		}
+		return false;
+
+	case Common::EVENT_LBUTTONUP:
+		if (_swallowLeftUp) {
+			_swallowLeftUp = false;
+			return true;
+		}
+		return false;
+
+	default:
+		return false;
+	}
+}
+
+bool VerbWheel::tick() {
+	_frame++;
+	runTests();
+	if (_state == kWaitTarget && _steps.empty() && _vm->_scummVars[kVarPrep] == 0) {
+		debug("Verbhjul: the sentence is no longer waiting");
+		_state = kClosed;
+	}
+	// A new room (or a loaded game): the queued clicks and the waiting sentence are stale
+	if ((!_steps.empty() || _state == kWaitTarget) && _vm->_currentRoom != _stepRoom) {
+		debug("Verbhjul: room changed; dropped %d queued clicks", (int)_steps.size());
+		_steps.clear();
+		if (_state == kWaitTarget)
+			_state = kClosed;
+	}
+	if (_steps.empty() || _vm->_userPut <= 0)
+		return false;
+
+	const Step st = _steps.remove_at(0);
+	switch (st.type) {
+	case kStepVerb:
+		// Checked again: a script may have switched the verb off since the choice
+		if (st.a >= 1 && st.a <= 17 && !verbActive(st.a)) {
+			debug("Verbhjul: verb %d is no longer in the panel; dropped the sentence", st.a);
+			_steps.clear();
+			if (_state == kWaitTarget)
+				_state = kClosed;
+			return false;
+		}
+		debug("Verbhjul: click verb %d", st.a);
+		_vm->runInputScript(kVerbClickArea, st.a, 0);
+		break;
+	case kStepKid:
+		// The same checks as ScummVM's F1 to F4, when the click is sent
+		if (!portraitsShown() || !kidAvailable(st.a) || st.a == _vm->_scummVars[_vm->VAR_EGO]) {
+			debug("Verbhjul: kid %d can not be chosen now; dropped", st.a);
+			return false;
+		}
+		debug("Verbhjul: click verb %d", kZakSwitch + st.a);
+		_vm->runInputScript(kVerbClickArea, kZakSwitch + st.a, 0);
+		break;
+	case kStepScene: {
+		// The input script finds the object at VAR_VIRT_MOUSE (global script 22)
+		const int ox = _vm->_scummVars[_vm->VAR_VIRT_MOUSE_X], oy = _vm->_scummVars[_vm->VAR_VIRT_MOUSE_Y];
+		_vm->_scummVars[_vm->VAR_VIRT_MOUSE_X] = st.a;
+		_vm->_scummVars[_vm->VAR_VIRT_MOUSE_Y] = st.b;
+		debug("Verbhjul: click room at %d,%d", st.a, st.b);
+		_vm->runInputScript(kSceneClickArea, 0, 0);
+		_vm->_scummVars[_vm->VAR_VIRT_MOUSE_X] = ox;
+		_vm->_scummVars[_vm->VAR_VIRT_MOUSE_Y] = oy;
+		break;
+	}
+	case kStepCheck:
+		// A preposition without a second object: the sentence waits. Clicking the
+		// sentence line now would clear it (global script 11 runs script 18).
+		if (_vm->_scummVars[kVarPrep] != 0 && _vm->_scummVars[kVarObjB] == 0 && _vm->_scummVars[kVarObjA] != 0) {
+			_state = kWaitTarget;
+			debug("Verbhjul: waiting for the second object (verb %d, object %d, preposition %d)",
+			      _vm->_scummVars[kVarVerb], _vm->_scummVars[kVarObjA], _vm->_scummVars[kVarPrep]);
+		} else {
+			debug("Verbhjul: click verb %d", kZakSentence);
+			_vm->runInputScript(kVerbClickArea, kZakSentence, 0);
+		}
+		break;
+	}
+	return true;
+}
+
+void VerbWheel::noteSentence(int verb, int objA, int objB) {
+	debug("Verbhjul: doSentence %d %d %d", verb, objA, objB);
+}
+
+// ------------------------------------------------------------------ text
+
+Common::String VerbWheel::verbName(int verbid) const {
+	const int slot = _vm->getVerbSlot(verbid, 0);
+	Common::String s;
+	if (slot > 0) {
+		const byte *p = _vm->getResourceAddress(rtVerb, slot);
+		for (int i = 0; p && p[i] && i < 40; i++)
+			if (p[i] >= 32 && p[i] < 127 && p[i] != '@')
+				s += (char)p[i];
+	}
+	s.trim();
+	return s.empty() ? Common::String(verbFallbackName(verbid)) : s;
+}
+
+Common::String VerbWheel::objectName(int obj) const {
+	const byte *p = _vm->getObjOrActorName(obj);
+	Common::String s;
+	for (int i = 0; p && p[i] && i < 60; i++)
+		if (p[i] >= 32 && p[i] < 127 && p[i] != '@')
+			s += (char)p[i];
+	s.trim();
+	return s;
+}
+
+Common::String VerbWheel::previewText() const {
+	const Common::String name = objectName(_obj);
+	if (_hover >= 0 && _slots[_hover])
+		return verbName(_slots[_hover]) + " " + name;
+	return name;
+}
+
+// ------------------------------------------------------------------ drawing
+
+uint32 VerbWheel::color(const Graphics::Surface &s, byte r, byte g, byte b) const {
+	if (s.format.bytesPerPixel > 1)
+		return s.format.RGBToColor(r, g, b);
+	// 8-bit screen: the nearest colour of the current palette
+	int best = 0, bestDist = 0x7FFFFFFF;
+	for (int i = 0; i < 256; i++) {
+		const int dr = _vm->_currentPalette[i * 3] - r, dg = _vm->_currentPalette[i * 3 + 1] - g, db = _vm->_currentPalette[i * 3 + 2] - b;
+		const int d = dr * dr + dg * dg + db * db;
+		if (d < bestDist) {
+			bestDist = d;
+			best = i;
+		}
+	}
+	return best;
+}
+
+void VerbWheel::fillCircle(Graphics::Surface &s, int cx, int cy, int rad, uint32 c) const {
+	for (int dy = -rad; dy <= rad; dy++) {
+		const int y = cy + dy;
+		if (y < 0 || y >= s.h)
+			continue;
+		int dx = 0;
+		while ((dx + 1) * (dx + 1) + dy * dy <= rad * rad)
+			dx++;
+		const int x0 = MAX(0, cx - dx), x1 = MIN<int>(s.w - 1, cx + dx);
+		if (x1 >= x0)
+			s.hLine(x0, y, x1, c);
+	}
+}
+
+Common::Rect VerbWheel::toScreen(const Common::Rect &r) const {
+	const int sw = g_system->getWidth(), sh = g_system->getHeight();
+	return Common::Rect(r.left * sw / _vm->_screenWidth, r.top * sh / _vm->_screenHeight,
+	                    (r.right * sw + _vm->_screenWidth - 1) / _vm->_screenWidth,
+	                    (r.bottom * sh + _vm->_screenHeight - 1) / _vm->_screenHeight);
+}
+
+void VerbWheel::restoreScreenRect(const Common::Rect &r) {
+	if (r.isEmpty())
+		return;
+#ifndef DISABLE_TOWNS_DUAL_LAYER_MODE
+	if (_vm->_townsScreen) {
+		_vm->_townsScreen->addDirtyRect(r.left, r.top, r.width(), r.height());
+		return;
+	}
+#endif
+	// Without the FM-Towns layers: let the engine copy everything again (not tested)
+	_vm->_fullRedraw = true;
+	_vm->markRectAsDirty(kVerbVirtScreen, 0, _vm->_screenWidth, 0, _vm->_virtscr[kVerbVirtScreen].h);
+	_vm->markRectAsDirty(kTextVirtScreen, 0, _vm->_screenWidth, 0, _vm->_virtscr[kTextVirtScreen].h);
+}
+
+void VerbWheel::draw() {
+	drawPortraits();
+	setInventoryGrid(inventoryGridWanted());
+	_wheelKeep = false;
+	if (_wheelOv.drawn || _invOv.drawn || _invGridOn || _state == kOpen) {
+		if (Graphics::Surface *s = g_system->lockScreen()) {
+			const bool tc = s->format.bytesPerPixel == 2 || s->format.bytesPerPixel == 4;
+			// Nothing changed (the same things to show, and the screen still has
+			// what the overlay wrote): the overlay stays as it is. Before 15 October
+			// both were built again every frame, which cost as much as the HD layer.
+			const Common::String ik = (_invGridOn && tc) ? inventoryKey(*s) : Common::String();
+			const Common::String wk = (_state == kOpen && tc) ? wheelKey(*s) : Common::String();
+			const bool invKeep = !ik.empty() && _invOv.drawn && _invOv.key == ik &&
+			                     overlayIntact(*s, _invOv, _wheelOv.drawn ? &_wheelOv.box : nullptr);
+			_wheelKeep = (invKeep || !_invGridOn) && !wk.empty() && _wheelOv.drawn && _wheelOv.key == wk &&
+			             overlayIntact(*s, _wheelOv, nullptr);
+			// Off the screen first, the wheel before the inventory it may lie on
+			if (!_wheelKeep)
+				restoreOverlay(*s, _wheelOv);
+			if (!invKeep) {
+				restoreOverlay(*s, _invOv);
+				if (!ik.empty()) {
+					drawInventory(*s);
+					_invOv.key = ik;
+				}
+			}
+			g_system->unlockScreen();
+		}
+	}
+	if (_state != kOpen) {
+		if (!_drawn.isEmpty() || !_textRect.isEmpty()) {
+			restoreScreenRect(_drawn);
+			restoreScreenRect(_textRect);
+			_drawn = Common::Rect();
+			_textRect = Common::Rect();
+			_shownText.clear();
+		}
+		return;
+	}
+	Graphics::Surface *s = g_system->lockScreen();
+	if (!s)
+		return;
+	// HD layer (16 or 32 bit colour): the drawn icons with soft edges
+	if ((s->format.bytesPerPixel == 2 || s->format.bytesPerPixel == 4) && drawHD(*s)) {
+		g_system->unlockScreen();
+		return;
+	}
+	// The small console font on the game's own 320 x 240 screen, the GUI font when the screen is larger
+	const Graphics::Font *font = FontMan.getFontByUsage(s->w >= 2 * _vm->_screenWidth ?
+		Graphics::FontManager::kGUIFont : Graphics::FontManager::kConsoleFont);
+	if (!font)
+		font = FontMan.getFontByUsage(Graphics::FontManager::kConsoleFont);
+
+	const uint32 cRing = color(*s, 214, 214, 224);
+	const uint32 cFill = color(*s, 32, 40, 72);
+	const uint32 cHover = color(*s, 240, 196, 48);
+	const uint32 cText = color(*s, 255, 255, 255);
+	const uint32 cTextHover = color(*s, 16, 16, 24);
+	const uint32 cBox = color(*s, 12, 12, 20);
+
+	const int scale = MAX(1, (int)(s->w / _vm->_screenWidth));
+	const int rs = kIcon * s->w / _vm->_screenWidth;
+	Common::Rect bbox;
+	for (int i = 0; i < 12; i++) {
+		if (!_slots[i])
+			continue;
+		const Common::Point g = slotCenter(i);
+		const int x = g.x * s->w / _vm->_screenWidth, y = g.y * s->h / _vm->_screenHeight;
+		const bool hot = (i == _hover);
+		fillCircle(*s, x, y, rs, cRing);
+		fillCircle(*s, x, y, rs - scale, hot ? cHover : cFill);
+		if (font) {
+			const char *label = verbLabel(_slots[i]);
+			const int fh = font->getFontHeight();
+			font->drawString(s, label, x - rs, y - fh / 2, 2 * rs, hot ? cTextHover : cText, Graphics::kTextAlignCenter);
+		}
+		Common::Rect r(x - rs, y - rs, x + rs + 1, y + rs + 1);
+		if (bbox.isEmpty())
+			bbox = r;
+		else
+			bbox.extend(r);
+	}
+	bbox.clip(Common::Rect(s->w, s->h));
+
+	// What the click will do, under the wheel
+	const Common::String text = previewText();
+	if (text != _shownText) {
+		restoreScreenRect(_textRect);  // the old box may be wider
+		_shownText = text;
+	}
+	Common::Rect box;
+	if (font && !text.empty()) {
+		const int tw = font->getStringWidth(text) + 8 * scale;
+		const int th = font->getFontHeight() + 4 * scale;
+		const int ty = (_center.y + kRadius + kIcon + 2) * s->h / _vm->_screenHeight;
+		const int tx = CLIP<int>(_center.x * s->w / _vm->_screenWidth - tw / 2, 0, MAX(0, s->w - tw));
+		box = Common::Rect(tx, ty, MIN<int>(s->w, tx + tw), MIN<int>(s->h, ty + th));
+		s->fillRect(box, cBox);
+		s->frameRect(box, cRing);
+		font->drawString(s, text, tx, ty + 2 * scale, tw, cText, Graphics::kTextAlignCenter);
+	}
+	g_system->unlockScreen();
+	if (!_drawn.isEmpty() && _drawn != bbox)
+		restoreScreenRect(_drawn);
+	_drawn = bbox;
+	_textRect.extend(box);
+	if (_textRect.isEmpty())
+		_textRect = box;
+}
+
+} // End of namespace Scumm
