+VerbWheel::VerbWheel(ScummEngine *vm) : _vm(vm) {
+	for (int i = 0; i < 12; i++)
+		_slots[i] = 0;
+	const Common::String app = Common::ConfigManager::kApplicationDomain;
+	if (ConfMan.hasKey("verbhjul", app))
+		_enabled = ConfMan.getBool("verbhjul", app);
+	if (ConfMan.hasKey("verbhjul_alle", app))
+		_allVerbs = ConfMan.getBool("verbhjul_alle", app);
+	if (ConfMan.hasKey("verbhjul_dynamisk", app))
+		_dynamic = ConfMan.getBool("verbhjul_dynamisk", app);
+	if (ConfMan.hasKey("verbhjul_portretter", app))
+		_portraits = ConfMan.getBool("verbhjul_portretter", app);
+	if (const char *e = getenv("VERBHJUL"))
+		_enabled = (*e != '0');
+	if (const char *e = getenv("VERBHJUL_ALLE"))
+		_allVerbs = (*e != '0');
+	if (const char *e = getenv("VERBHJUL_DYNAMISK"))
+		_dynamic = (*e != '0');
+	if (const char *e = getenv("VERBHJUL_PORTRETTER"))
+		_portraits = (*e != '0');
+	if (const char *d = getenv("VERBHJUL_DUMP_DIR"))
+		_dumpDir = d;
+	if (const char *t = getenv("VERBHJUL_TEST"))
+		parseTests(t);
+	loadRules();
+	debug("Verbhjul: %s, %s, portraits %s, %d rules", _enabled ? "on" : "off",
+	      _allVerbs ? "all verbs" : (_dynamic ? "dynamic" : "the object's verbs"),
+	      _portraits ? "on" : "off", (int)_rules.size());
+}
+
+void VerbWheel::loadRules() {
+	for (const VerbWheelRule *r = kZakVerbWheelRules; r->spec; r++) {
+		Rule rule;
+		Common::StringTokenizer words(r->spec, " ");
+		while (!words.empty()) {
+			const Common::String w = words.nextToken();
+			if (w.size() < 3 || w[1] != '=')
+				continue;
+			const Common::String v = w.substr(2);
+			if (w[0] == 'g') {
+				Common::StringTokenizer groups(v, ";");
+				while (!groups.empty()) {
+					Common::Array<int> g;
+					Common::StringTokenizer verbs(groups.nextToken(), ",");
+					while (!verbs.empty())
+						g.push_back(atoi(verbs.nextToken().c_str()));
+					if (!g.empty())
+						rule.groups.push_back(g);
+				}
+			} else if (w[0] == 'p') {
+				// a/b:cond
+				Pair p;
+				p.a = atoi(v.c_str());
+				const size_t slash = v.find('/'), colon = v.find(':');
+				if (slash == Common::String::npos || colon == Common::String::npos || colon + 1 >= v.size())
+					continue;
+				p.b = atoi(v.c_str() + slash + 1);
+				Common::StringTokenizer conds(v.substr(colon + 1), "+");
+				while (!conds.empty()) {
+					const Common::String c = conds.nextToken();
+					if (c.empty())
+						continue;
+					Cond cond;
+					cond.type = c[0];
+					cond.arg = atoi(c.c_str() + 1);
+					cond.bit = 0;
+					const size_t dot = c.find('.'), eq = c.find('=');
+					if (dot != Common::String::npos)
+						cond.bit = atoi(c.c_str() + dot + 1);
+					if (eq != Common::String::npos) {
+						Common::StringTokenizer vals(c.substr(eq + 1), "|");
+						while (!vals.empty())
+							cond.values.push_back(atoi(vals.nextToken().c_str()));
+					}
+					p.conds.push_back(cond);
+				}
+				rule.pairs.push_back(p);
+			} else if (w[0] == 'i' || w[0] == 'r' || w[0] == 'x') {
+				uint32 &mask = w[0] == 'i' ? rule.invOnly : (w[0] == 'r' ? rule.roomOnly : rule.never);
+				Common::StringTokenizer verbs(v, ",");
+				while (!verbs.empty()) {
+					const int verb = atoi(verbs.nextToken().c_str());
+					if (verb > 0 && verb < 32)
+						mask |= 1u << verb;
+				}
+			}
+		}
+		_rules[r->obj] = rule;
+	}
+}
