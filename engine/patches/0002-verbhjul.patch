+
+/*
+ * Verb wheel (verbhjul) for Zak McKracken, FM-Towns (SCUMM v3), in the
+ * style of Day of the Tentacle Remastered. See docs/VERBHJUL.md in the
+ * ZakMcKracken-HD repository.
+ *
+ * Right click (or a long press, which the web player sends as a right
+ * click) on an object or an inventory item opens a wheel around the
+ * pointer. The wheel has twelve fixed clock positions, one per action verb:
+ *
+ *   12 Pick up (Buy)   1 Open     2 Close    3 Use
+ *    4 Give (Sell)     5 Turn on  6 Turn off 7 Put on
+ *    8 Take off        9 Read    10 Push (Teleport to)  11 Pull
+ *
+ * Buy, Sell and Teleport to take the place of the verb they replace in the
+ * original verb panel. A verb is only shown while its slot in the original
+ * panel is switched on, so the shop and the teleport modes need no special
+ * handling. Inventory items always get Give (or Sell in the shop), which the
+ * game's sentence script handles for any item.
+ *
+ * Which icons an object gets:
+ *  - Dynamic (default): at most four. Verbs that run the same object code
+ *    share one icon, Open/Close and Turn on/Turn off show only the one that
+ *    fits the object's state, and a few objects have hand-made rules. The
+ *    rules come from verbhjul_zak.h, generated by tools/verbhjul_dynamisk.py
+ *    from the game's scripts. One rule per object, words separated by spaces:
+ *      g=2,6;1,7;14   the icons; the verbs of a group run the same code
+ *      p=2/7:s        of the icons with verb 2 and verb 7 only one is shown:
+ *                     the one with 7 when the condition holds. s = the
+ *                     object's state is not 0, s92 = the state of object 92,
+ *                     c6 = class 6 is set, C6 = class 6 is not set,
+ *                     v222=14|16 = Var[222] is 14 or 16, b143.0 = bit 0
+ *                     of Var[143] is set; several joined by + mean "or"
+ *      i=11 / r=8     these verbs only in the inventory / only in the room
+ *      x=11           these verbs never (they only give a remark)
+ *    An icon sends one verb of its group (the pair's verb, or the first of
+ *    Open, Close, Pick up, Turn on, Turn off, Put on, Take off, Read, Use,
+ *    Push, Pull, Give, Buy, Sell, Teleport to) and sits at that verb's clock
+ *    position. Objects without a rule get one icon per verb.
+ *  - The object's verbs (verbhjul_dynamisk off): one icon per verb in the
+ *    object's verb table (its OC block).
+ *  - All verbs (verbhjul_alle): every active verb.
+ *
+ * Character portraits: while the game lets the player switch kid (the
+ * Switch verb is on), small portraits of the kids that can be chosen stand in
+ * the bottom right corner, the current one highlighted. Clicking one sends
+ * the same click as choosing the kid's name after Switch (verbs 37 to 40),
+ * as ScummVM's F1 to F4 do. The Switch button itself is then hidden. This
+ * works with the wheel on or off.
+ *
+ * Choosing a verb sends exactly the clicks a player would make on the
+ * original panel, one per frame, through the game's own input script
+ * (global script 11): Walk to and the sentence line when something is left
+ * of the last sentence (this clears it), the verb, the object (a scene click at the stored
+ * point, or the inventory slot), then the sentence line (verb 100), which
+ * runs the sentence. No game script is changed. When the sentence waits
+ * for a second object (Use ... with, Give ... to; the input script has set
+ * a preposition), the sentence line is not clicked, since that would clear
+ * the sentence. The wheel closes, and the next left click on an object, a
+ * person or an inventory item sends that click and then the sentence line.
+ * The inventory arrows scroll without ending the wait. A right click cancels by clicking Walk to, which clears the sentence
+ * the same way the original panel does.
+ *
+ * With the wheel on, the original verb buttons 1 to 17 are not drawn and
+ * not clickable; their keyboard shortcuts still work. All other verbs (the
+ * sentence line, the inventory, Switch, the kids' names and the special
+ * verbs when playing an animal) stay as they are.
+ *
+ * Settings (application domain): verbhjul (on/off, default on),
+ * verbhjul_dynamisk (dynamic icons, default on), verbhjul_alle (all verbs,
+ * default off), verbhjul_portretter (portraits, default on). Environment
+ * variables with the same names in capitals override them.
+ * Ctrl+W switches the wheel on and off while playing.
+ *
+ * Test hooks for running without a screen:
+ *   VERBHJUL_TEST=frame:command,...  commands: esc, key=<ascii>, ctrl=<ascii>, fkey=<n>,
+ *       click=x/y, rclick=x/y, rdrag=x/y>verb, pick=verb, portrait=<1..4>,
+ *       setvar=n/value, setbit=n.bit/value, script=n, rules, dump=name, log, quit.
+ *       rules: writes every parsed rule back and compares it with verbhjul_zak.h.
+ *       Coordinates are game pixels (320 x 240); frames are calls to tick().
+ *   VERBHJUL_DUMP_DIR  where dump=name writes name.png (the screen).
+ * Every injected click, every wheel opened and every doSentence is logged
+ * with debug() as "Verbhjul: ...".
+ */
+
+#ifndef SCUMM_VERBHJUL_H
+#define SCUMM_VERBHJUL_H
+
+#include "common/array.h"
+#include "common/events.h"
+#include "common/hashmap.h"
+#include "common/rect.h"
+#include "common/str.h"
+
+namespace Graphics {
+struct Surface;
+}
+
+namespace Scumm {
+
+class ScummEngine;
+
+class VerbWheel {
+public:
+	/** Returns a wheel for Zak McKracken FM-Towns, nullptr for other games. */
+	static VerbWheel *create(ScummEngine *vm);
+	~VerbWheel();
+
+	/** First look at every event. True means the engine must not see it. */
+	bool handleEvent(const Common::Event &ev);
+	/** Called once per frame at the start of checkExecVerbs. True: this frame's input is used. */
+	bool tick();
+	/** Draws the wheel on the system screen, right before updateScreen. */
+	void draw();
+	/** True for the original verb buttons the wheel replaces, while it is on. */
+	bool hidesVerb(int verbid) const;
+	/** Logs every sentence the game runs (for the tests). */
+	void noteSentence(int verb, int objA, int objB);
+
+	bool isEnabled() const { return _enabled; }
+
+private:
+	enum State { kClosed, kOpen, kWaitTarget };
+	enum StepType { kStepVerb, kStepScene, kStepCheck, kStepKid };
+	struct Step { StepType type; int a, b; };
+	struct TestCmd { int frame; Common::String cmd, arg; };
+
+	// A rule of the dynamic wheel (see verbhjul_zak.h)
+	struct Cond {
+		char type;               // 's' state, 'c' class set, 'C' class not set, 'v' variable, 'b' bit
+		int arg;                 // object (0 = this one), class or variable
+		int bit;
+		Common::Array<int> values;
+	};
+	struct Pair {
+		int a, b;
+		Common::Array<Cond> conds;   // any of them true: show b
+	};
+	struct Rule {
+		Common::Array<Common::Array<int> > groups;
+		Common::Array<Pair> pairs;
+		uint32 invOnly = 0, roomOnly = 0, never = 0;   // bit per verb
+	};
+
+	explicit VerbWheel(ScummEngine *vm);
+
+	// What is under a point (game screen coordinates): object or inventory slot
+	bool targetAt(int x, int y, int &obj, int &invVerb, Common::Point &virt);
+	bool open(int x, int y, bool byPress);
+	void close();
+	void choose(int slotIndex);
+	void queueTarget(int obj, int invVerb, const Common::Point &virt);
+	void queueStep(StepType type, int a, int b);
+	void collectVerbs(int obj, bool inventory);
+	void collectDynamic(const Rule &rule, int obj, bool inventory);
+	bool condition(const Cond &c, int obj) const;
+	void placeVerb(int v);
+	void loadRules();
+	static Common::String ruleText(const Rule &rule);   // the rule written back (test: rules)
+	bool verbActive(int verbid) const;
+
+	// Character portraits
+	bool portraitsShown() const;
+	bool kidAvailable(int kid) const;
+	Common::Rect portraitRect(int kid) const;   // game screen coordinates
+	int portraitAt(int x, int y) const;
+	void drawPortraits();
+	int hoverAt(int x, int y) const;
+	Common::Point slotCenter(int i) const;
+	Common::String verbName(int verbid) const;
+	Common::String objectName(int obj) const;
+	Common::String previewText() const;
+	void setEnabled(bool on);
+
+	// Drawing on the system screen
+	uint32 color(const Graphics::Surface &s, byte r, byte g, byte b) const;
+	void fillCircle(Graphics::Surface &s, int cx, int cy, int rad, uint32 c) const;
+	void restoreScreenRect(const Common::Rect &r);
+	Common::Rect toScreen(const Common::Rect &r) const;
+
+	// Tests
+	void parseTests(const char *spec);
+	void runTests();
+	void pushMouse(Common::EventType type, int x, int y);
+	void pushKey(Common::KeyCode code, uint16 ascii, byte flags = 0);
+	void dumpScreen(const Common::String &name);
+
+	ScummEngine *_vm;
+	bool _enabled = true;
+	bool _allVerbs = false;
+	bool _dynamic = true;
+	bool _portraits = true;
+	Common::HashMap<int, Rule> _rules;
+	Common::Rect _portraitDrawn;   // screen rectangle of the portraits drawn last time
+	Common::String _portraitShown; // what was drawn (kids and the current one)
+	State _state = kClosed;
+	bool _openedByPress = false;
+	bool _pressMoved = false;
+	Common::Point _center;   // game screen coordinates of the wheel
+	Common::Point _press;    // where the right button went down
+	int _obj = 0;
+	int _invVerb = 0;        // 101..110 when the wheel is on an inventory item
+	Common::Point _virt;     // room coordinates of the object click
+	int _slots[12];          // verb id per clock position, 0 = empty
+	int _hover = -1;
+	Common::Rect _drawn;     // screen rectangle drawn last time
+	Common::Rect _textRect;  // screen rectangle of the preview text
+	Common::String _shownText;
+	bool _restoreAll = false;
+	Common::Array<Step> _steps;
+	int _waitVerb = 0;
+	int _waitObj = 0;
+	int _stepRoom = -1;      // the room the queued clicks and the waiting sentence belong to
+	uint32 _frame = 0;
+	Common::Array<TestCmd> _tests;
+	Common::String _dumpDir;
+	int _rdragVerb = 0;      // test: verb to drag to after a right press
+	int _upFrame = -1;       // test: frame to release a pending button
+	bool _upRight = false;
+	Common::Point _upPos;
+	bool _swallowLeftUp = false;
+	bool _swallowRightUp = false;
+};
+
+} // End of namespace Scumm
+
+#endif
