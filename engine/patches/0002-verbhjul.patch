+namespace {
+
+// A pixel of a true colour screen (16 or 32 bits)
+inline uint32 getPx(const Graphics::Surface &s, int x, int y) {
+	const void *p = s.getBasePtr(x, y);
+	return s.format.bytesPerPixel == 2 ? *(const uint16 *)p : *(const uint32 *)p;
+}
+
+inline void setPx(Graphics::Surface &s, int x, int y, uint32 c) {
+	void *p = s.getBasePtr(x, y);
+	if (s.format.bytesPerPixel == 2)
+		*(uint16 *)p = (uint16)c;
+	else
+		*(uint32 *)p = c;
+}
+
+} // End of anonymous namespace
+
+// The composed picture of an overlay's box, in RGB floats
+struct VerbWheel::Canvas {
+	Common::Rect box;
+	Common::Array<float> rgb;
+	void blend(int x, int y, float r, float g, float b, float a) {
+		if (a <= 0 || !box.contains(x, y))
+			return;
+		if (a > 1)
+			a = 1;
+		float *p = &rgb[((y - box.top) * box.width() + (x - box.left)) * 3];
+		p[0] += (r - p[0]) * a;
+		p[1] += (g - p[1]) * a;
+		p[2] += (b - p[2]) * a;
+	}
+	// A disc with a soft edge (soft = width of the edge in pixels)
+	void disc(float cx, float cy, float rad, float r, float g, float b, float alpha, float soft = 1.2f) {
+		const int x0 = (int)floorf(cx - rad - soft), x1 = (int)ceilf(cx + rad + soft);
+		const int y0 = (int)floorf(cy - rad - soft), y1 = (int)ceilf(cy + rad + soft);
+		for (int y = y0; y <= y1; y++) {
+			for (int x = x0; x <= x1; x++) {
+				const float dx = x + 0.5f - cx, dy = y + 0.5f - cy;
+				const float d = sqrtf(dx * dx + dy * dy) - rad;
+				const float cov = CLIP<float>(0.5f - d / soft, 0, 1);
+				if (cov > 0)
+					blend(x, y, r, g, b, alpha * cov);
+			}
+		}
+	}
+	void roundRect(const Common::Rect &rc, float rad, float r, float g, float b, float alpha) {
+		const float cx = (rc.left + rc.right) / 2.0f, cy = (rc.top + rc.bottom) / 2.0f;
+		const float hw = rc.width() / 2.0f - rad, hh = rc.height() / 2.0f - rad;
+		for (int y = rc.top - 1; y <= rc.bottom; y++) {
+			for (int x = rc.left - 1; x <= rc.right; x++) {
+				const float qx = fabsf(x + 0.5f - cx) - hw, qy = fabsf(y + 0.5f - cy) - hh;
+				const float ox = MAX(qx, 0.0f), oy = MAX(qy, 0.0f);
+				const float d = sqrtf(ox * ox + oy * oy) + MIN(MAX(qx, qy), 0.0f) - rad;
+				const float cov = CLIP<float>(0.5f - d, 0, 1);
+				if (cov > 0)
+					blend(x, y, r, g, b, alpha * cov);
+			}
+		}
+	}
+	void image(const VerbWheel::Img &img, int x0, int y0, float alpha = 1.0f) {
+		for (int y = 0; y < img.h; y++) {
+			for (int x = 0; x < img.w; x++) {
+				const byte *p = &img.px[(y * img.w + x) * 4];
+				if (p[3])
+					blend(x0 + x, y0 + y, p[0], p[1], p[2], p[3] / 255.0f * alpha);
+			}
+		}
+	}
+};
+
+// Text in the built-in font with a dark outline: the first `split` letters in
+// gold, the rest in cream. x and baseline in screen pixels, f the font scale.
+void VerbWheel::drawText(Canvas &cv, const Common::Rect &clip, const Common::String &text, int split,
+                         float x, int baseline, float f) const {
+	const Common::Rect tb = clip.findIntersectingRect(cv.box);
+	if (tb.isEmpty() || !_font.w)
+		return;
+	const int mw = tb.width(), mh = tb.height();
+	Common::Array<float> mVerb(mw * mh, 0.0f), mName(mw * mh, 0.0f);
+	float pen = x;
+	for (uint i = 0; i < text.size(); i++) {
+		const int c = (byte)text[i];
+		if (c < 32 || c >= 127)
+			continue;
+		const short *gl = kVerbWheelGlyphs[c - 32];
+		Common::Array<float> &m = ((int)i < split) ? mVerb : mName;
+		const float gx = pen + gl[4] * f, gy = baseline + gl[5] * f;
+		const int w = (int)ceilf(gl[2] * f) + 2, h = (int)ceilf(gl[3] * f) + 2;
+		for (int y = 0; y < h; y++) {
+			for (int xx = 0; xx < w; xx++) {
+				const int X = (int)floorf(gx) + xx, Y = (int)floorf(gy) + y;
+				if (X < tb.left || X >= tb.right || Y < tb.top || Y >= tb.bottom)
+					continue;
+				// Bilinear sample of the glyph
+				const float u = (X + 0.5f - gx) / f - 0.5f, v = (Y + 0.5f - gy) / f - 0.5f;
+				const int u0 = (int)floorf(u), v0 = (int)floorf(v);
+				const float fu = u - u0, fv = v - v0;
+				float a = 0;
+				for (int j = 0; j < 2; j++) {
+					for (int k = 0; k < 2; k++) {
+						const int ax = u0 + k, ay = v0 + j;
+						if (ax < 0 || ay < 0 || ax >= gl[2] || ay >= gl[3])
+							continue;
+						const float wgt = (k ? fu : 1 - fu) * (j ? fv : 1 - fv);
+						a += wgt * _font.px[((gl[1] + ay) * _font.w + gl[0] + ax) * 4 + 3] / 255.0f;
+					}
+				}
+				float &d = m[(Y - tb.top) * mw + (X - tb.left)];
+				d = MAX(d, a);
+			}
+		}
+		pen += gl[6] * f;
+	}
+	const int ro = MAX(1, (int)(2.5f * f + 0.5f));
+	for (int y = 0; y < mh; y++) {
+		for (int xx = 0; xx < mw; xx++) {
+			float o = 0;
+			for (int dy = -ro; dy <= ro && o < 1; dy++) {
+				for (int dx = -ro; dx <= ro; dx++) {
+					if (dx * dx + dy * dy > ro * ro + ro)
+						continue;
+					const int X = xx + dx, Y = y + dy;
+					if (X < 0 || Y < 0 || X >= mw || Y >= mh)
+						continue;
+					o = MAX(o, MAX(mVerb[Y * mw + X], mName[Y * mw + X]));
+				}
+			}
+			if (o > 0)
+				cv.blend(tb.left + xx, tb.top + y, 16, 10, 8, o);
+		}
+	}
+	for (int y = 0; y < mh; y++) {
+		for (int xx = 0; xx < mw; xx++) {
+			cv.blend(tb.left + xx, tb.top + y, 245, 197, 52, mVerb[y * mw + xx]);
+			cv.blend(tb.left + xx, tb.top + y, 250, 243, 228, mName[y * mw + xx]);
+		}
+	}
+}
+
+// A label: the text in a gold-rimmed dark box. Returns the box.
+void VerbWheel::drawLabel(Canvas &cv, const Common::Rect &box, const Common::String &text, int split, float f) const {
+	const float rad = box.height() / 2.0f;
+	cv.roundRect(box, rad, 245, 197, 52, 1.0f);
+	const int b = (int)ceilf(3 * f);
+	cv.roundRect(Common::Rect(box.left + b, box.top + b, box.right - b, box.bottom - b), rad - 3 * f, 34, 24, 30, 0.92f);
+	const int padX = (int)(16 * f), padY = (int)(6 * f);
+	drawText(cv, box, text, split, box.left + padX, box.top + padY + (int)(kVerbWheelFontAscent * f), f);
+}
+
+Common::Rect VerbWheel::labelBox(const Common::String &text, float f, int centerX, int top, int bottomLimit,
+                                 int altBottom, int screenW) const {
+	const int tw = textWidth(text, f);
+	const int th = (int)ceilf((kVerbWheelFontAscent + kVerbWheelFontDescent) * f);
+	const int w = tw + 2 * (int)(16 * f), h = th + 2 * (int)(6 * f);
+	if (top + h > bottomLimit)
+		top = altBottom - h;
+	const int left = CLIP<int>(centerX - w / 2, 0, MAX(0, screenW - w));
+	return Common::Rect(left, top, left + w, top + h);
+}
+
+// ------------------------------------------------------------------ overlays
+
+// Takes an overlay off the screen: where the screen still has what the overlay
+// wrote, the game's pixels from under it are put back.
+void VerbWheel::restoreOverlay(Graphics::Surface &s, Overlay &ov) {
+	if (ov.drawn && (s.format.bytesPerPixel == 2 || s.format.bytesPerPixel == 4)) {
+		Common::Rect r = ov.box;
+		r.clip(Common::Rect(s.w, s.h));
+		for (int y = r.top; y < r.bottom; y++) {
+			for (int x = r.left; x < r.right; x++) {
+				const int k = (y - ov.box.top) * ov.box.width() + (x - ov.box.left);
+				if (getPx(s, x, y) == ov.last[k])
+					setPx(s, x, y, ov.under[k]);
+			}
+		}
+	}
+	ov.drawn = false;
+	ov.box = Common::Rect();
+	ov.under.clear();
+	ov.last.clear();
+}
+
+// Whether the screen still shows what the overlay wrote (outside `skip`)
+bool VerbWheel::overlayIntact(const Graphics::Surface &s, const Overlay &ov, const Common::Rect *skip) const {
+	if (!ov.drawn || ov.box.right > s.w || ov.box.bottom > s.h || ov.box.isEmpty())
+		return false;
+	const int w = ov.box.width();
+	for (int y = ov.box.top; y < ov.box.bottom; y++) {
+		const uint32 *last = &ov.last[(y - ov.box.top) * w];
+		for (int x = ov.box.left; x < ov.box.right; x++) {
+			if (skip && skip->contains(x, y))
+				continue;
+			if (getPx(s, x, y) != last[x - ov.box.left])
+				return false;
+		}
+	}
+	return true;
+}
+
+// What the wheel shows; the same key means the same picture
+Common::String VerbWheel::wheelKey(const Graphics::Surface &s) const {
+	const uint32 t = g_system->getMillis() - _openedAt;
+	Common::String k = Common::String::format("%dx%d %d,%d o%d h%d %s", s.w, s.h, _center.x, _center.y, _obj, _hover,
+		t < 160 ? Common::String::format("t%u", t).c_str() : "done");
+	for (int i = 0; i < 12; i++)
+		k += Common::String::format(" %d", _slots[i]);
+	return k + " " + objectName(_obj);
+}
+
+// What the inventory grid shows: the things, their names, the arrows, the
+// portraits and what is under the pointer
+Common::String VerbWheel::inventoryKey(const Graphics::Surface &s) const {
+	Common::String k = Common::String::format("%dx%d s%d m%d,%d", s.w, s.h, (int)_state,
+		_state == kClosed ? inventoryVerbAt(_vm->_mouse.x, _vm->_mouse.y) : -1,
+		_state == kClosed ? portraitAt(_vm->_mouse.x, _vm->_mouse.y) : 0);
+	for (int i = 0; i < 10; i++) {
+		const int slot = _vm->getVerbSlot(kZakInvFirst + i, 0);
+		const int obj = _vm->_scummVars[kVarInventory + i];
+		const bool on = slot > 0 && _vm->_verbs[slot].curmode == 1 && obj > 0;
+		k += on ? Common::String::format("|%d:", obj) + objectName(obj) : Common::String("|-");
+	}
+	for (int d = 0; d < 2; d++) {
+		const int slot = _vm->getVerbSlot(d ? kZakInvDown : kZakInvUp, 0);
+		k += (slot > 0 && _vm->_verbs[slot].curmode == 1) ? "A" : "a";
+	}
+	if (portraitsShown()) {
+		k += Common::String::format(" ego%d ", _vm->_scummVars[_vm->VAR_EGO]);
+		for (int kid = 1; kid <= 4; kid++)
+			k += kidAvailable(kid) ? '1' : '0';
+	}
+	return k;
+}
+
+// Starts an overlay: the canvas holds the game's pixels in the box
+void VerbWheel::beginOverlay(Graphics::Surface &s, Overlay &ov, Canvas &cv, const Common::Rect &box) {
+	ov.box = box;
+	ov.under.resize(box.width() * box.height());
+	cv.box = box;
+	cv.rgb.resize(box.width() * box.height() * 3);
+	for (int y = box.top; y < box.bottom; y++) {
+		for (int x = box.left; x < box.right; x++) {
+			const int k = (y - box.top) * box.width() + (x - box.left);
+			const uint32 c = getPx(s, x, y);
+			ov.under[k] = c;
+			byte r, g, b;
+			s.format.colorToRGB(c, r, g, b);
+			cv.rgb[k * 3] = r; cv.rgb[k * 3 + 1] = g; cv.rgb[k * 3 + 2] = b;
+		}
+	}
+}
+
+void VerbWheel::endOverlay(Graphics::Surface &s, Overlay &ov, const Canvas &cv) {
+	ov.last.resize(ov.box.width() * ov.box.height());
+	for (int y = ov.box.top; y < ov.box.bottom; y++) {
+		for (int x = ov.box.left; x < ov.box.right; x++) {
+			const int k = (y - ov.box.top) * ov.box.width() + (x - ov.box.left);
+			const float *p = &cv.rgb[k * 3];
+			const uint32 out = s.format.RGBToColor((byte)CLIP<float>(p[0] + 0.5f, 0, 255), (byte)CLIP<float>(p[1] + 0.5f, 0, 255),
+			                                       (byte)CLIP<float>(p[2] + 0.5f, 0, 255));
+			setPx(s, x, y, out);
+			ov.last[k] = out;
+		}
+	}
+	ov.drawn = true;
+}
+
+// ------------------------------------------------------------------ the wheel in HD
+
+bool VerbWheel::drawHD(Graphics::Surface &s) {
+	loadHD();
+	if (_iconSrc.empty() || _font.w == 0)
+		return false;
+	if (_wheelKeep)
+		return true;   // unchanged since the last frame (draw())
+	const float sx = (float)s.w / _vm->_screenWidth, sy = (float)s.h / _vm->_screenHeight;
+	const float f = sx / 4;   // the font and the details are made for a screen 4 times the original
+	const float t = MIN(1.0f, (g_system->getMillis() - _openedAt) / 140.0f);
+	const float grow = 1 - (1 - t) * (1 - t) * (1 - t);
+
+	struct Spot { float x, y, r; int verb; bool hot; };
+	Common::Array<Spot> spots;
+	Common::Rect bbox;
+	for (int i = 0; i < 12; i++) {
+		if (!_slots[i])
+			continue;
+		const Common::Point g = slotCenter(i);
+		// The icons come out from the point that was clicked
+		const float gx = _center.x + (g.x - _center.x) * grow, gy = _center.y + (g.y - _center.y) * grow;
+		Spot sp;
+		sp.x = (gx + 0.5f) * sx;
+		sp.y = (gy + 0.5f) * sy;
+		sp.hot = (i == _hover);
+		sp.r = (sp.hot ? kIconHoverHD : kIconHD) * sx * (0.55f + 0.45f * grow);
+		sp.verb = _slots[i];
+		spots.push_back(sp);
+		const int m = (int)ceilf(sp.r + 10 * f);
+		Common::Rect r((int)sp.x - m, (int)sp.y - m, (int)sp.x + m + 8 * (int)ceilf(f), (int)sp.y + m + 10 * (int)ceilf(f));
+		if (bbox.isEmpty())
+			bbox = r;
+		else
+			bbox.extend(r);
+	}
+
+	// What the click will do, under the wheel; the verb in gold
+	Common::String text = objectName(_obj);
+	int split = 0;
+	if (_hover >= 0 && _slots[_hover]) {
+		const Common::String verb = verbName(_slots[_hover]);
+		text = verb + " " + text;
+		split = verb.size();
+	}
+	Common::Rect label;
+	if (!text.empty()) {
+		label = labelBox(text, f, (int)(_center.x * sx), (int)((_center.y + kRadius + kIconHD + 3) * sy), s.h,
+		                 (int)((_center.y - kRadius - kIconHD - 3) * sy), s.w);
+		if (bbox.isEmpty())
+			bbox = label;
+		else
+			bbox.extend(label);
+	}
+	bbox.clip(Common::Rect(s.w, s.h));
+	if (bbox.isEmpty())
+		return true;
+
+	Canvas cv;
+	beginOverlay(s, _wheelOv, cv, bbox);
+	// Shadows first, so no shadow falls on a neighbour
+	for (uint i = 0; i < spots.size(); i++)
+		cv.disc(spots[i].x + 3 * f, spots[i].y + 6 * f, spots[i].r * 0.98f, 20, 12, 8, 0.45f, 6 * f + 1);
+	for (uint i = 0; i < spots.size(); i++) {
+		const Spot &sp = spots[i];
+		if (sp.hot)
+			cv.disc(sp.x, sp.y, sp.r + 5 * f, 245, 197, 52, 1.0f, 1.5f);
+		const int size = MAX(2, (int)(2 * sp.r + 0.5f));
+		const Img *img = iconAt(sp.verb, size);
+		if (!img) {
+			cv.disc(sp.x, sp.y, sp.r, 247, 236, 211, 1.0f);
+			continue;
+		}
+		cv.image(*img, (int)(sp.x - img->w / 2.0f + 0.5f), (int)(sp.y - img->h / 2.0f + 0.5f));
+	}
+	if (!label.isEmpty())
+		drawLabel(cv, label, text, split, f);
+	endOverlay(s, _wheelOv, cv);
+	_wheelOv.key = wheelKey(s);
+	return true;
+}
+
+// ------------------------------------------------------------------ the inventory in HD
+
+void VerbWheel::setInventoryGrid(bool on) {
+	if (_invGridOn == on)
+		return;
+	_invGridOn = on;
+	debug("Verbhjul: inventory as pictures %s", on ? "on" : "off");
+	// The portraits move to the column by the grid (or back to the corner)
+	if (!_portraitDrawn.isEmpty()) {
+		restoreScreenRect(_portraitDrawn);
+		_portraitDrawn = Common::Rect();
+		_portraitShown.clear();
+	}
+	// The text inventory and the arrows are hidden or drawn again
+	_vm->redrawVerbs();
+}
+
+bool VerbWheel::inventoryGridWanted() const {
+	if (!_enabled || !_invGrid || !_vm->_digHD)
+		return false;
+	// The panel shows the kids' names, Done or the animals' verbs where the grid
+	// would be: the text inventory then stays as in the original
+	for (int i = 1; i < _vm->_numVerbs; i++) {
+		const VerbSlot &vs = _vm->_verbs[i];
+		if (vs.curmode == 1 && vs.verbid >= 31 && vs.verbid <= 40 && !hidesVerb(vs.verbid) &&
+		    vs.curRect.top < kInvBottom && vs.curRect.bottom > kInvTop)
+			return false;
+	}
+	return true;
+}
+
+Common::Rect VerbWheel::inventoryCell(int i) const {
+	const int col = i % 5, row = i / 5;
+	const int x0 = kInvLeft + col * (kInvCellsRight - kInvLeft) / 5, x1 = kInvLeft + (col + 1) * (kInvCellsRight - kInvLeft) / 5;
+	const int y0 = kInvTop + row * (kInvBottom - kInvTop) / 2, y1 = kInvTop + (row + 1) * (kInvBottom - kInvTop) / 2;
+	return Common::Rect(x0 + 1, y0 + 1, x1 - 1, y1 - 1);
+}
+
+Common::Rect VerbWheel::inventoryArrow(bool down) const {
+	return down ? Common::Rect(kInvCellsRight + 2, kInvBottom - kInvArrowH, kInvRight, kInvBottom)
+	            : Common::Rect(kInvCellsRight + 2, kInvTop, kInvRight, kInvTop + kInvArrowH);
+}
+
+int VerbWheel::inventoryVerbAt(int x, int y) const {
+	if (!_invGridOn || y < kInvTop || y >= kInvBottom || x < kInvLeft || x >= kInvRight)
+		return -1;
+	for (int i = 0; i < 10; i++) {
+		if (!inventoryCell(i).contains(x, y))
+			continue;
+		const int slot = _vm->getVerbSlot(kZakInvFirst + i, 0);
+		if (slot > 0 && _vm->_verbs[slot].curmode == 1 && _vm->_scummVars[kVarInventory + i] > 0)
+			return slot;
+		return 0;
+	}
+	for (int d = 0; d < 2; d++) {
+		if (!inventoryArrow(d == 1).contains(x, y))
+			continue;
+		const int slot = _vm->getVerbSlot(d ? kZakInvDown : kZakInvUp, 0);
+		return (slot > 0 && _vm->_verbs[slot].curmode == 1) ? slot : 0;
+	}
+	return 0;
+}
+
+void VerbWheel::drawInventory(Graphics::Surface &s) {
+	loadHD();
+	const float sx = (float)s.w / _vm->_screenWidth, sy = (float)s.h / _vm->_screenHeight;
+	const float f = sx / 4;
+	auto toScr = [&](const Common::Rect &r) {
+		return Common::Rect((int)(r.left * sx), (int)(r.top * sy), (int)(r.right * sx), (int)(r.bottom * sy));
+	};
+
+	Common::Rect box = toScr(Common::Rect(kInvLeft, kInvTop, kInvRight, kInvBottom));
+	const int hoverCell = (_state == kClosed) ? inventoryVerbAt(_vm->_mouse.x, _vm->_mouse.y) : -1;
+	Common::String hoverText;
+	Common::Rect hoverRect;
+	int shown = 0;
+	for (int i = 0; i < 10; i++) {
+		const int slot = _vm->getVerbSlot(kZakInvFirst + i, 0);
+		if (slot > 0 && _vm->_verbs[slot].curmode == 1 && _vm->_scummVars[kVarInventory + i] > 0)
+			shown++;
+	}
+	if (!shown && _vm->getVerbSlot(kZakInvUp, 0) <= 0 && !portraitsShown())
+		return;
+
+	// The name over the cell under the pointer, when the cell shows a picture
+	Common::Rect label;
+	for (int i = 0; i < 10 && hoverCell > 0; i++) {
+		if (_vm->getVerbSlot(kZakInvFirst + i, 0) != hoverCell)
+			continue;
+		const int obj = _vm->_scummVars[kVarInventory + i];
+		hoverRect = toScr(inventoryCell(i));
+		if (inventoryImage(obj, hoverRect.width(), hoverRect.height())) {
+			hoverText = objectName(obj);
+			// The name at the bottom of the cell, over the picture (the sentence line is above)
+			label = labelBox(hoverText, f * 0.8f, (hoverRect.left + hoverRect.right) / 2, 0, s.h, 0, s.w);
+			label.translate(0, hoverRect.bottom - label.bottom - (int)(4 * f));
+			if (label.left < hoverRect.left - (int)(20 * f) || label.right > hoverRect.right + (int)(20 * f))
+				label.translate(CLIP<int>((hoverRect.left + hoverRect.right) / 2 - (label.left + label.right) / 2, -label.left, s.w - label.right), 0);
+			box.extend(label);
+		}
+	}
+	box.clip(Common::Rect(s.w, s.h));
+
+	Canvas cv;
+	beginOverlay(s, _invOv, cv, box);
+	for (int i = 0; i < 10; i++) {
+		const int slot = _vm->getVerbSlot(kZakInvFirst + i, 0);
+		const int obj = _vm->_scummVars[kVarInventory + i];
+		if (slot <= 0 || _vm->_verbs[slot].curmode != 1 || obj <= 0)
+			continue;
+		const Common::Rect c = toScr(inventoryCell(i));
+		const bool hot = (slot == hoverCell);
+		cv.roundRect(c, 10 * f, hot ? 245 : 70, hot ? 197 : 58, hot ? 52 : 84, hot ? 0.45f : 0.55f);
+		const int pad = (int)(6 * f);
+		if (const Img *img = inventoryImage(obj, c.width() - 2 * pad, c.height() - 2 * pad)) {
+			cv.image(*img, c.left + (c.width() - img->w) / 2, c.top + (c.height() - img->h) / 2);
+			continue;
+		}
+		// No picture yet: the name, on one or two lines, made smaller until it fits
+		const Common::String name = objectName(obj);
+		float tf = f * 0.75f;
+		Common::String l1 = name, l2;
+		const int maxW = c.width() - 2 * pad;
+		if (textWidth(name, tf) > maxW) {
+			// Split at the space nearest the middle
+			int best = -1;
+			for (uint k = 0; k < name.size(); k++)
+				if (name[k] == ' ' && (best < 0 || ABS((int)k - (int)name.size() / 2) < ABS(best - (int)name.size() / 2)))
+					best = k;
+			if (best > 0) {
+				l1 = Common::String(name.c_str(), best);
+				l2 = Common::String(name.c_str() + best + 1);
+			}
+			const int w = MAX(textWidth(l1, tf), textWidth(l2, tf));
+			if (w > maxW)
+				tf *= (float)maxW / w;
+		}
+		const float lh = (kVerbWheelFontAscent + kVerbWheelFontDescent) * tf * 0.9f;
+		const int lines = l2.empty() ? 1 : 2;
+		const float top = c.top + (c.height() - lines * lh) / 2;
+		drawText(cv, c, l1, 0, c.left + (c.width() - textWidth(l1, tf)) / 2.0f, (int)(top + kVerbWheelFontAscent * tf), tf);
+		if (!l2.empty())
+			drawText(cv, c, l2, 0, c.left + (c.width() - textWidth(l2, tf)) / 2.0f, (int)(top + lh + kVerbWheelFontAscent * tf), tf);
+	}
+	// The arrows: gold triangles when the inventory can scroll that way
+	for (int d = 0; d < 2; d++) {
+		const int slot = _vm->getVerbSlot(d ? kZakInvDown : kZakInvUp, 0);
+		if (slot <= 0 || _vm->_verbs[slot].curmode != 1)
+			continue;
+		const Common::Rect a = toScr(inventoryArrow(d == 1));
+		const bool hot = (slot == hoverCell);
+		cv.roundRect(a, 8 * f, 70, 58, 84, hot ? 0.9f : 0.55f);
+		const float cx = (a.left + a.right) / 2.0f, cy = (a.top + a.bottom) / 2.0f, r = MIN(a.width(), a.height()) * 0.32f;
+		// Triangle: apex up (or down), the base below (or above), 4 x 4 samples per pixel
+		const float ay = d ? cy + r : cy - r, by = d ? cy - r * 0.7f : cy + r * 0.7f;
+		for (int y = (int)(cy - r) - 1; y <= (int)(cy + r) + 1; y++) {
+			for (int x = (int)(cx - r) - 1; x <= (int)(cx + r) + 1; x++) {
+				int in = 0;
+				for (int j = 0; j < 4; j++) {
+					for (int k = 0; k < 4; k++) {
+						const float px = x + (k + 0.5f) / 4, py = y + (j + 0.5f) / 4;
+						const float t = (py - ay) / (by - ay);   // 0 at the apex, 1 at the base
+						if (t >= 0 && t <= 1 && fabsf(px - cx) <= r * t)
+							in++;
+					}
+				}
+				if (in)
+					cv.blend(x, y, 245, 197, 52, in / 16.0f);
+			}
+		}
+	}
+	// The kids that can be chosen, as portraits; the one played now has a gold ring
+	if (portraitsShown()) {
+		static const char *const kKidName[4] = { "Zak", "Annie", "Melissa", "Leslie" };
+		const int ego = _vm->_scummVars[_vm->VAR_EGO];
+		const int hotKid = (_state == kClosed) ? portraitAt(_vm->_mouse.x, _vm->_mouse.y) : 0;
+		for (int k = 1; k <= 4; k++) {
+			if (!kidAvailable(k) && k != ego)
+				continue;
+			const Common::Rect r = toScr(portraitRect(k));
+			const float cx = (r.left + r.right) / 2.0f, cy = (r.top + r.bottom) / 2.0f;
+			float rad = MIN(r.width(), r.height()) / 2.0f - 2 * f;
+			if (k == hotKid)
+				rad += 4 * f;
+			cv.disc(cx + 2 * f, cy + 4 * f, rad, 20, 12, 8, 0.4f, 4 * f + 1);
+			if (k == ego)
+				cv.disc(cx, cy, rad + 5 * f, 245, 197, 52, 1.0f, 1.5f);
+			if (const Img *img = iconAt(100 + k, MAX(2, (int)(2 * rad + 0.5f))))
+				cv.image(*img, (int)(cx - img->w / 2.0f + 0.5f), (int)(cy - img->h / 2.0f + 0.5f), (k == ego || k == hotKid) ? 1.0f : 0.85f);
+			if (k == hotKid) {
+				hoverText = kKidName[k - 1];
+				label = labelBox(hoverText, f * 0.8f, (int)cx, 0, s.h, 0, s.w);
+				label.translate(0, r.top - label.bottom - (int)(2 * f));
+				label.translate(CLIP<int>(0, -label.left, s.w - label.right), 0);
+			}
+		}
+	}
+	if (!label.isEmpty())
+		drawLabel(cv, label, hoverText, 0, f * 0.8f);
+	endOverlay(s, _invOv, cv);
+}
+
+} // End of namespace Scumm
